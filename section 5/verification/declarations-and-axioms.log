theorem DiamondIntegral.Section5.GammaFinitePerturbation.comparison_eventually.{u_1} : ∀ {G : Type u_1}
  [inst : CommGroup.{u_1} G] [inst_1 : LinearOrder.{u_1} G] [IsOrderedMonoid.{u_1} G]
  [inst_3 : TopologicalSpace.{u_1} G] [OrderTopology.{u_1} G] (a b : G) (p q : ℤ),
