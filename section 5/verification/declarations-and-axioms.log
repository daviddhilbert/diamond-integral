                (congrArg.{(max u_5 u_6 u_1) + 1, max (u_1 + 1) (u_4 + 1)}
                  FirstOrder.Language.Formula.Realize.{u_5, u_6, u_4, u_1}
                  (ite_eq_left_of_eq_true.{max (max (u_1 + 1) (u_6 + 1)) (u_5 + 1)} Top.top.{max (max u_1 u_6) u_5}
                    (FirstOrder.Language.Formula.not.{u_5, u_6, u_1}
                      (DiamondIntegral.Section5.tupleEqualityFormula.{u_1, u_2, u_5, u_6} (f i) (f j)))
                    (Eq.trans.{1} (congrFun'.{u_3 + 1, 1} (congrArg.{u_3 + 1, u_3 + 1} Eq.{u_3 + 1} hij) j)
                      (eq_self.{u_3 + 1} j))))
                v)
              FirstOrder.Language.Formula.realize_top._simp_1.{u_5, u_6, u_4, u_1})
        else
          Eq.mpr.{0}
            (id.{0}
              (congrArg.{max (max (u_1 + 1) (u_5 + 1)) (u_6 + 1), 1}
                (fun _a => FirstOrder.Language.Formula.Realize.{u_5, u_6, u_4, u_1} _a v)
                (if_neg.{max (max (u_1 + 1) (u_5 + 1)) (u_6 + 1)} hij)))
            (Eq.mpr.{0}
              (id.{0}
                (congrArg.{1, 1} (fun _a => _a) (propext FirstOrder.Language.Formula.realize_not.{u_5, u_6, u_4, u_1})))
              (Eq.mpr.{0}
                (id.{0}
                  (congrArg.{1, 1} (fun _a => ¬_a)
                    (propext
                      (DiamondIntegral.Section5.tupleEqualityFormula_realize.{u_1, u_2, u_4, u_5, u_6} (f i) (f j) v))))
                fun he => hij (h he))) }
