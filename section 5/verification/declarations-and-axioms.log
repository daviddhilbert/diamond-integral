theorem DiamondIntegral.Section5.no_injective_fin_iff_card_bound.{u_1} : ∀ {X : Type u_1} (S : Set.{u_1} X) (N : ℕ),
  (∀ (f : Fin (HAdd.hAdd.{0, 0, 0} N 1) → ↑S), ¬Function.Injective.{1, u_1 + 1} f) ↔
    Set.Finite.{u_1} S ∧ LE.le.{0} (Set.ncard.{u_1} S) N :=
fun {X} S N =>
  {
    mp := fun h =>
      have hS :=
        Decidable.byContradiction fun hn =>
          let e := Set.Infinite.natEmbedding.{u_1} S hn;
          h (fun i => e ↑i)
            (Function.Injective.comp.{1, 1, u_1 + 1} (Function.Embedding.injective.{1, u_1 + 1} e) Fin.val_injective);
      have hcard :=
        Decidable.byContradiction fun hn =>
          have hle :=
            Eq.mpr.{0}
              (id.{0}
                (congrFun'.{1, 1} (congrArg.{1, 1} LE.le.{0} (Fintype.card_fin (HAdd.hAdd.{0, 0, 0} N 1)))
                  (Fintype.card.{u_1} ↑S)))
              (Nat.succ_le_of_lt (Nat.lt_of_not_ge hn));
          Nonempty.casesOn.{u_1 + 1} (Function.Embedding.nonempty_of_card_le.{0, u_1} hle) fun e =>
            h (⇑e) (Function.Embedding.injective.{1, u_1 + 1} e);
