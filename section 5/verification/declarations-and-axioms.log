fun {G} [CommGroup.{u_1} G] [LinearOrder.{u_1} G] [IsOrderedMonoid.{u_1} G] [TopologicalSpace.{u_1} G]
    [OrderTopology.{u_1} G] a b p q h =>
  Or.casesOn (lt_trichotomy.{u_1} a b)
    (fun hab =>
      have hc :=
        Continuous.mul.{u_1, u_1} continuous_const.{u_1, u_1} (Continuous.zpow.{u_1, u_1} continuous_id.{u_1} p);
      have hd :=
        Continuous.mul.{u_1, u_1} continuous_const.{u_1, u_1} (Continuous.zpow.{u_1, u_1} continuous_id.{u_1} q);
      have ho :=
        IsOpen.mem_nhds.{u_1} (isOpen_lt.{u_1, u_1} hc hd)
          (have this :=
            Eq.mpr.{0}
              (id.{0}
                (congr.{u_1 + 1, 1}
                  (congrArg.{u_1 + 1, u_1 + 1} LT.lt.{u_1}
                    (Eq.trans.{u_1 + 1} (congrArg.{u_1 + 1, u_1 + 1} (HMul.hMul.{u_1, u_1, u_1} a) (one_zpow.{u_1} p))
                      (mul_one.{u_1} a)))
                  (Eq.trans.{u_1 + 1} (congrArg.{u_1 + 1, u_1 + 1} (HMul.hMul.{u_1, u_1, u_1} b) (one_zpow.{u_1} q))
                    (mul_one.{u_1} b))))
              hab;
          this);
      Filter.mp_mem.{u_1} ho
        (Filter.univ_mem'.{u_1} (id.{0} fun e he => iff_of_true (le_of_lt.{u_1} he) (le_of_lt.{u_1} hab))))
    fun h_1 =>
    Or.casesOn h_1
      (fun hab =>
        have hpq := h hab;
        Eq.ndrec.{0, u_1 + 1} (motive := fun b =>
          (Eq.{u_1 + 1} a b → Eq.{1} p q) →
            ∀ᶠ (e : G) in nhds.{u_1} 1,
              LE.le.{u_1} (HMul.hMul.{u_1, u_1, u_1} a (HPow.hPow.{u_1, 0, u_1} e p))
                  (HMul.hMul.{u_1, u_1, u_1} b (HPow.hPow.{u_1, 0, u_1} e q)) ↔
                LE.le.{u_1} a b)
          (fun h =>
            Eq.ndrec.{0, 1} (motive := fun q =>
              (Eq.{u_1 + 1} a a → Eq.{1} p q) →
                ∀ᶠ (e : G) in nhds.{u_1} 1,
                  LE.le.{u_1} (HMul.hMul.{u_1, u_1, u_1} a (HPow.hPow.{u_1, 0, u_1} e p))
                      (HMul.hMul.{u_1, u_1, u_1} a (HPow.hPow.{u_1, 0, u_1} e q)) ↔
                    LE.le.{u_1} a a)
              (fun h => Filter.Eventually.of_forall.{u_1} fun x => iff_of_true le_rfl.{u_1} le_rfl.{u_1}) hpq h)
          hab h)
      fun hab =>
      have hc :=
        Continuous.mul.{u_1, u_1} continuous_const.{u_1, u_1} (Continuous.zpow.{u_1, u_1} continuous_id.{u_1} p);
      have hd :=
        Continuous.mul.{u_1, u_1} continuous_const.{u_1, u_1} (Continuous.zpow.{u_1, u_1} continuous_id.{u_1} q);
      have ho :=
        IsOpen.mem_nhds.{u_1} (isOpen_lt.{u_1, u_1} hd hc)
          (have this :=
            Eq.mpr.{0}
              (id.{0}
                (congr.{u_1 + 1, 1}
                  (congrArg.{u_1 + 1, u_1 + 1} LT.lt.{u_1}
                    (Eq.trans.{u_1 + 1} (congrArg.{u_1 + 1, u_1 + 1} (HMul.hMul.{u_1, u_1, u_1} b) (one_zpow.{u_1} q))
                      (mul_one.{u_1} b)))
                  (Eq.trans.{u_1 + 1} (congrArg.{u_1 + 1, u_1 + 1} (HMul.hMul.{u_1, u_1, u_1} a) (one_zpow.{u_1} p))
                    (mul_one.{u_1} a))))
              hab;
          this);
      Filter.mp_mem.{u_1} ho
        (Filter.univ_mem'.{u_1} (id.{0} fun e he => iff_of_false (not_le.{u_1}.mpr he) (not_le.{u_1}.mpr hab)))
