fun {A} [CommRing.{u} A] P x y he a ha =>
  have h := Finset.ext_iff.{u}.mp he a;
  Eq.mp.{0}
    (congr.{1, 1}
      (congrArg.{1, 1} Iff
        (Eq.trans.{1} DiamondIntegral.Section5.primeSignSupport_test._simp_1_1.{u}
          (Eq.trans.{1}
            (congrFun'.{1, 1} (congrArg.{1, 1} And (eq_true ha))
              (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} x) a))
            (true_and (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} x) a)))))
      (Eq.trans.{1} DiamondIntegral.Section5.primeSignSupport_test._simp_1_1.{u}
        (Eq.trans.{1}
          (congrFun'.{1, 1} (congrArg.{1, 1} And (eq_true ha)) (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} y) a))
          (true_and (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} y) a)))))
    h
theorem DiamondIntegral.Section5.constructibleData_same_sign.{u} : ∀ {A : Type u} [inst : CommRing.{u} A]
  (S : PrimeSpectrum.ConstructibleSetData.{u} A) (x y : PrimeSpectrum.{u} A),
  Eq.{u + 1}
      (DiamondIntegral.Section5.primeSignSupport.{u} (DiamondIntegral.Section5.constructibleTestPolynomials.{u} S) x)
      (DiamondIntegral.Section5.primeSignSupport.{u} (DiamondIntegral.Section5.constructibleTestPolynomials.{u} S) y) →
    (Membership.mem.{u, u} (PrimeSpectrum.ConstructibleSetData.toSet.{u} S) x ↔
      Membership.mem.{u, u} (PrimeSpectrum.ConstructibleSetData.toSet.{u} S) y) :=
fun {A} [CommRing.{u} A] S x y he =>
  have hd := fun D hD =>
    have hf :=
      DiamondIntegral.Section5.primeSignSupport_test.{u} (DiamondIntegral.Section5.constructibleTestPolynomials.{u} S) x
        y he (PrimeSpectrum.BasicConstructibleSetData.f.{u} D)
        (DiamondIntegral.Section5.constructibleTestPolynomials_denominator.{u} S D hD);
    have hg := fun i =>
      DiamondIntegral.Section5.primeSignSupport_test.{u} (DiamondIntegral.Section5.constructibleTestPolynomials.{u} S) x
        y he (PrimeSpectrum.BasicConstructibleSetData.g.{u} D i)
        (DiamondIntegral.Section5.constructibleTestPolynomials_equation.{u} S D hD i);
    Eq.mpr.{0}
      (id.{0}
        (congr.{1, 1}
          (congrArg.{1, 1} Iff
            (Eq.trans.{1} (DiamondIntegral.Section5.constructibleData_same_sign._simp_1_1.{u} x)
              (congr.{1, 1}
                (congrArg.{1, 1} And
                  (Eq.trans.{1}
                    (DiamondIntegral.Section5.constructibleData_same_sign._simp_1_2.{u} x
                      (Set.range.{u, 1} (PrimeSpectrum.BasicConstructibleSetData.g.{u} D)))
                    (Eq.trans.{1} DiamondIntegral.Section5.constructibleData_same_sign._simp_1_3.{u, 1}
                      (forall_congr.{1} fun y =>
                        DiamondIntegral.Section5.constructibleData_same_sign._simp_1_5.{u, u}))))
                (congrArg.{1, 1} Not
                  (Eq.trans.{1}
                    (DiamondIntegral.Section5.constructibleData_same_sign._simp_1_2.{u} x
                      (singleton.{u, u} (PrimeSpectrum.BasicConstructibleSetData.f.{u} D)))
                    (Eq.trans.{1} DiamondIntegral.Section5.constructibleData_same_sign._simp_1_4.{u}
                      DiamondIntegral.Section5.constructibleData_same_sign._simp_1_5.{u, u}))))))
          (Eq.trans.{1} (DiamondIntegral.Section5.constructibleData_same_sign._simp_1_1.{u} y)
            (congr.{1, 1}
              (congrArg.{1, 1} And
                (Eq.trans.{1}
                  (DiamondIntegral.Section5.constructibleData_same_sign._simp_1_2.{u} y
                    (Set.range.{u, 1} (PrimeSpectrum.BasicConstructibleSetData.g.{u} D)))
                  (Eq.trans.{1} DiamondIntegral.Section5.constructibleData_same_sign._simp_1_3.{u, 1}
                    (forall_congr.{1} fun y_1 =>
                      DiamondIntegral.Section5.constructibleData_same_sign._simp_1_5.{u, u}))))
              (congrArg.{1, 1} Not
                (Eq.trans.{1}
                  (DiamondIntegral.Section5.constructibleData_same_sign._simp_1_2.{u} y
                    (singleton.{u, u} (PrimeSpectrum.BasicConstructibleSetData.f.{u} D)))
                  (Eq.trans.{1} DiamondIntegral.Section5.constructibleData_same_sign._simp_1_4.{u}
                    DiamondIntegral.Section5.constructibleData_same_sign._simp_1_5.{u, u})))))))
      (and_congr (forall_congr'.{1} hg) (not_congr hf));
  {
    mp := fun hx =>
      Exists.casesOn.{u + 1} (Set.mem_iUnion.{u, u + 1}.mp hx) fun D hx =>
        Exists.casesOn.{0} (Set.mem_iUnion.{u, 0}.mp hx) fun hD hx =>
          Set.mem_iUnion.{u, u + 1}.mpr
            (Exists.intro.{u + 1} D (Set.mem_iUnion.{u, 0}.mpr (Exists.intro.{0} hD ((hd D hD).mp hx)))),
    mpr := fun hy =>
      Exists.casesOn.{u + 1} (Set.mem_iUnion.{u, u + 1}.mp hy) fun D hy =>
        Exists.casesOn.{0} (Set.mem_iUnion.{u, 0}.mp hy) fun hD hy =>
          Set.mem_iUnion.{u, u + 1}.mpr
            (Exists.intro.{u + 1} D (Set.mem_iUnion.{u, 0}.mpr (Exists.intro.{0} hD ((hd D hD).mpr hy)))) }
theorem DiamondIntegral.Section5.finite_disjoint_basic_constructible_partition.{u} : ∀ {A : Type u}
  [inst : CommRing.{u} A] (Z : Set.{u} (PrimeSpectrum.{u} A)),
  Topology.IsConstructible.{u} Z →
    ∃ ι x D,
      (∀ (i : ι), PrimeSpectrum.BasicConstructibleSetData.toSet.{u} (D i) ⊆ Z) ∧
        ∀ (x : PrimeSpectrum.{u} A),
          Membership.mem.{u, u} Z x ↔
            ExistsUnique.{u + 1} fun i =>
              Membership.mem.{u, u} (PrimeSpectrum.BasicConstructibleSetData.toSet.{u} (D i)) x :=
fun {A} [CommRing.{u} A] Z hZ =>
  Exists.casesOn.{u + 1} (PrimeSpectrum.exists_constructibleSetData_iff.{u}.mpr hZ) fun S h =>
    Eq.ndrec.{0, u + 1} (motive := fun Z =>
      Topology.IsConstructible.{u} Z →
        ∃ ι x D,
          (∀ (i : ι), PrimeSpectrum.BasicConstructibleSetData.toSet.{u} (D i) ⊆ Z) ∧
            ∀ (x : PrimeSpectrum.{u} A),
              Membership.mem.{u, u} Z x ↔
                ExistsUnique.{u + 1} fun i =>
                  Membership.mem.{u, u} (PrimeSpectrum.BasicConstructibleSetData.toSet.{u} (D i)) x)
      (fun hZ =>
        let P := DiamondIntegral.Section5.constructibleTestPolynomials.{u} S;
        let I :=
          Subtype.{u + 1} fun T =>
            ∃ x,
              Membership.mem.{u, u} (PrimeSpectrum.ConstructibleSetData.toSet.{u} S) x ∧
                Eq.{u + 1} (DiamondIntegral.Section5.primeSignSupport.{u} P x) ↑T;
        let D := fun i => DiamondIntegral.Section5.primeSignAtomData.{u} P ↑↑i;
        have hsub := fun i =>
          Exists.casesOn.{u + 1} (Subtype.property.{u + 1} i) fun x h =>
            And.casesOn.{0} h fun hx hxT ⦃y⦄ hy =>
              have hyT :=
                (DiamondIntegral.Section5.primeSignAtomData_support.{u} P (↑↑i)
                      (Finset.mem_powerset.{u}.mp (Subtype.property.{u + 1} ↑i)) y).mp
                  hy;
              (DiamondIntegral.Section5.constructibleData_same_sign.{u} S x y
                    (Eq.trans.{u + 1} hxT (Eq.symm.{u + 1} hyT))).mp
                hx;
        Exists.intro.{u + 2} I
          (Exists.intro.{u + 1} inferInstance.{u + 1}
            (Exists.intro.{u + 1} D
              ⟨hsub, fun x =>
                {
                  mp := fun hx =>
                    let T :=
                      Subtype.mk.{u + 1} (DiamondIntegral.Section5.primeSignSupport.{u} P x)
                        (Finset.mem_powerset.{u}.mpr
                          (Finset.filter_subset.{u} (fun a => Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} x) a)
                            P));
                    let i := Subtype.mk.{u + 1} T (Exists.intro.{u + 1} x ⟨hx, rfl.{u + 1}⟩);
                    Exists.intro.{u + 1} i
                      ⟨(DiamondIntegral.Section5.primeSignAtomData_support.{u} P (↑T)
                              (Finset.mem_powerset.{u}.mp (Subtype.property.{u + 1} T)) x).mpr
                          rfl.{u + 1},
                        fun j hj =>
                        Subtype.ext.{u + 1}
                          (Subtype.ext.{u + 1}
                            (Eq.symm.{u + 1}
                              ((DiamondIntegral.Section5.primeSignAtomData_support.{u} P (↑↑j)
                                    (Finset.mem_powerset.{u}.mp (Subtype.property.{u + 1} ↑j)) x).mp
                                hj)))⟩,
                  mpr := fun a => Exists.casesOn.{u + 1} a fun i h => And.casesOn.{0} h fun hi right => hsub i hi }⟩)))
      h hZ
theorem DiamondIntegral.Section5.primeSignSupport_restrict.{u} : ∀ {A : Type u} [inst : CommRing.{u} A]
  (P Q : Finset.{u} A),
  Q ⊆ P →
    ∀ (x y : PrimeSpectrum.{u} A),
      Eq.{u + 1} (DiamondIntegral.Section5.primeSignSupport.{u} P x)
          (DiamondIntegral.Section5.primeSignSupport.{u} P y) →
        Eq.{u + 1} (DiamondIntegral.Section5.primeSignSupport.{u} Q x)
          (DiamondIntegral.Section5.primeSignSupport.{u} Q y) :=
fun {A} [CommRing.{u} A] P Q hQP x y he =>
  Finset.ext.{u} fun a =>
    if ha : Membership.mem.{u, u} Q a then
      Eq.mpr.{0}
        (id.{0}
          (congr.{1, 1}
            (congrArg.{1, 1} Iff
              (Eq.trans.{1} DiamondIntegral.Section5.primeSignSupport_restrict._simp_1_1.{u}
                (Eq.trans.{1}
                  (congrFun'.{1, 1} (congrArg.{1, 1} And (eq_true ha))
                    (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} x) a))
                  (true_and (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} x) a)))))
            (Eq.trans.{1} DiamondIntegral.Section5.primeSignSupport_restrict._simp_1_1.{u}
              (Eq.trans.{1}
                (congrFun'.{1, 1} (congrArg.{1, 1} And (eq_true ha))
                  (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} y) a))
                (true_and (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} y) a))))))
        (DiamondIntegral.Section5.primeSignSupport_test.{u} P x y he a (hQP ha))
    else
      of_eq_true
        (Eq.trans.{1}
          (congr.{1, 1}
            (congrArg.{1, 1} Iff
              (Eq.trans.{1} Finset.mem_filter._simp_1.{u}
                (Eq.trans.{1}
                  (congrFun'.{1, 1} (congrArg.{1, 1} And (eq_false ha))
                    (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} x) a))
                  (false_and (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} x) a)))))
            (Eq.trans.{1} Finset.mem_filter._simp_1.{u}
              (Eq.trans.{1}
                (congrFun'.{1, 1} (congrArg.{1, 1} And (eq_false ha))
                  (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} y) a))
                (false_and (Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} y) a)))))
          (iff_self False))
theorem DiamondIntegral.Section5.finite_constructible_test_family.{u, u_1} : ∀ {A : Type u} [inst : CommRing.{u} A]
  {ι : Type u_1} [Fintype.{u_1} ι] (Z : ι → Set.{u} (PrimeSpectrum.{u} A)),
  (∀ (i : ι), Topology.IsConstructible.{u} (Z i)) →
    ∃ P,
      ∀ (i : ι) (x y : PrimeSpectrum.{u} A),
        Eq.{u + 1} (DiamondIntegral.Section5.primeSignSupport.{u} P x)
            (DiamondIntegral.Section5.primeSignSupport.{u} P y) →
          (Membership.mem.{u, u} (Z i) x ↔ Membership.mem.{u, u} (Z i) y) :=
fun {A} [CommRing.{u} A] {ι} [Fintype.{u_1} ι] Z hZ =>
  (fun S hS =>
      let allData := Finset.biUnion.{u_1, u} Finset.univ.{u_1} S;
      let P := DiamondIntegral.Section5.constructibleTestPolynomials.{u} allData;
      have hsub := fun i ⦃a⦄ ha =>
        Exists.casesOn.{u + 1} (Finset.mem_biUnion.{u, u}.mp ha) fun D h =>
          And.casesOn.{0} h fun hD ha =>
            Finset.mem_biUnion.{u, u}.mpr
              (Exists.intro.{u + 1} D
                ⟨Finset.mem_biUnion.{u_1, u}.mpr (Exists.intro.{u_1 + 1} i ⟨Finset.mem_univ.{u_1} i, hD⟩), ha⟩);
      Exists.intro.{u + 1} P fun i x y he =>
        Eq.mpr.{0}
          (id.{0}
            (congrArg.{u + 1, 1} (fun _a => Membership.mem.{u, u} _a x ↔ Membership.mem.{u, u} _a y)
              (Eq.symm.{u + 1} (hS i))))
          (DiamondIntegral.Section5.constructibleData_same_sign.{u} (S i) x y
            (DiamondIntegral.Section5.primeSignSupport_restrict.{u} P
              (DiamondIntegral.Section5.constructibleTestPolynomials.{u} (S i)) (hsub i) x y he)))
    (fun i => Classical.choose.{u + 1} ((fun i => PrimeSpectrum.exists_constructibleSetData_iff.{u}.mpr (hZ i)) i))
    fun i => Classical.choose_spec.{u + 1} ((fun i => PrimeSpectrum.exists_constructibleSetData_iff.{u}.mpr (hZ i)) i)
theorem DiamondIntegral.Section5.finite_subordinate_basic_partition.{u, u_1} : ∀ {A : Type u} [inst : CommRing.{u} A]
  {ι : Type u_1} [Fintype.{u_1} ι] (Z : Set.{u} (PrimeSpectrum.{u} A)),
  Topology.IsConstructible.{u} Z →
    ∀ (C : ι → Set.{u} (PrimeSpectrum.{u} A)),
      (∀ (i : ι), Topology.IsConstructible.{u} (C i)) →
        (∀ (x : PrimeSpectrum.{u} A), Membership.mem.{u, u} Z x → ∃ i, Membership.mem.{u, u} (C i) x) →
          ∃ J x D select,
            (∀ (j : J), PrimeSpectrum.BasicConstructibleSetData.toSet.{u} (D j) ⊆ Inter.inter.{u} Z (C (select j))) ∧
              ∀ (x : PrimeSpectrum.{u} A),
                Membership.mem.{u, u} Z x ↔
                  ExistsUnique.{u + 1} fun j =>
                    Membership.mem.{u, u} (PrimeSpectrum.BasicConstructibleSetData.toSet.{u} (D j)) x :=
fun {A} [CommRing.{u} A] {ι} [Fintype.{u_1} ι] Z hZ C hC hcover =>
  let F := fun i => Option.elim.{u_1, u + 1} i Z C;
  have hF := fun i =>
    Option.casesOn.{0, u_1} (motive := fun t => Eq.{u_1 + 1} i t → Topology.IsConstructible.{u} (F i)) i
      (fun h => Eq.ndrec.{0, u_1 + 1} hZ (Eq.symm.{u_1 + 1} h))
      (fun i_1 h => Eq.ndrec.{0, u_1 + 1} (hC i_1) (Eq.symm.{u_1 + 1} h)) (Eq.refl.{u_1 + 1} i);
  Exists.casesOn.{u + 1} (DiamondIntegral.Section5.finite_constructible_test_family.{u, u_1} F hF) fun P hsame =>
    let J :=
      Subtype.{u + 1} fun T =>
        ∃ x, Membership.mem.{u, u} Z x ∧ Eq.{u + 1} (DiamondIntegral.Section5.primeSignSupport.{u} P x) ↑T;
    let D := fun j => DiamondIntegral.Section5.primeSignAtomData.{u} P ↑↑j;
    let w := fun j => Classical.choose.{u + 1} (Subtype.property.{u + 1} j);
    have hw := fun j => Classical.choose_spec.{u + 1} (Subtype.property.{u + 1} j);
    let select := fun j => Classical.choose.{u_1 + 1} (hcover (w j) (hw j).left);
    have hselect := fun j => Classical.choose_spec.{u_1 + 1} (hcover (w j) (hw j).left);
    have hsub := fun j ⦃x⦄ hx =>
      have hpx :=
        (DiamondIntegral.Section5.primeSignAtomData_support.{u} P (↑↑j)
              (Finset.mem_powerset.{u}.mp (Subtype.property.{u + 1} ↑j)) x).mp
          hx;
      have he := Eq.trans.{u + 1} (hw j).right (Eq.symm.{u + 1} hpx);
      ⟨(hsame none.{u_1} (w j) x he).mp (hw j).left, (hsame (some.{u_1} (select j)) (w j) x he).mp (hselect j)⟩;
    Exists.intro.{u + 2} J
      (Exists.intro.{u + 1} inferInstance.{u + 1}
        (Exists.intro.{u + 1} D
          (Exists.intro.{max (u + 1) (u_1 + 1)} select
            ⟨hsub, fun x =>
              {
                mp := fun hx =>
                  let T :=
                    Subtype.mk.{u + 1} (DiamondIntegral.Section5.primeSignSupport.{u} P x)
                      (Finset.mem_powerset.{u}.mpr
                        (Finset.filter_subset.{u} (fun a => Membership.mem.{u, u} (PrimeSpectrum.asIdeal.{u} x) a) P));
                  let j := Subtype.mk.{u + 1} T (Exists.intro.{u + 1} x ⟨hx, rfl.{u + 1}⟩);
                  Exists.intro.{u + 1} j
                    ⟨(DiamondIntegral.Section5.primeSignAtomData_support.{u} P (↑T)
                            (Finset.mem_powerset.{u}.mp (Subtype.property.{u + 1} T)) x).mpr
                        rfl.{u + 1},
                      fun k hk =>
                      Subtype.ext.{u + 1}
                        (Subtype.ext.{u + 1}
                          (Eq.symm.{u + 1}
                            ((DiamondIntegral.Section5.primeSignAtomData_support.{u} P (↑↑k)
                                  (Finset.mem_powerset.{u}.mp (Subtype.property.{u + 1} ↑k)) x).mp
                              hk)))⟩,
                mpr := fun a =>
                  Exists.casesOn.{u + 1} a fun j h => And.casesOn.{0} h fun hj right => (hsub j hj).left }⟩)))
theorem DiamondIntegral.Section5.basicConstructibleData_isConstructible.{u_1} : ∀ {A : Type u_1}
  [inst : CommRing.{u_1} A] (D : PrimeSpectrum.BasicConstructibleSetData.{u_1} A),
  Topology.IsConstructible.{u_1} (PrimeSpectrum.BasicConstructibleSetData.toSet.{u_1} D) :=
fun {A} [CommRing.{u_1} A] D =>
  have h := PrimeSpectrum.ConstructibleSetData.isConstructible_toSet.{u_1} (singleton.{u_1, u_1} D);
  Eq.mp.{0}
    (congrArg.{u_1 + 1, 1} Topology.IsConstructible.{u_1}
      (Eq.trans.{u_1 + 1}
        (congrArg.{u_1 + 1, u_1 + 1} Set.iUnion.{u_1, u_1 + 1}
          (funext.{u_1 + 1, u_1 + 1} fun C =>
            Set.iUnion_congr_Prop.{u_1} (Iff.of_eq Finset.mem_singleton._simp_1.{u_1}) fun x =>
              Eq.refl.{u_1 + 1} (PrimeSpectrum.BasicConstructibleSetData.toSet.{u_1} C)))
        Set.iUnion_iUnion_eq_left.{u_1, u_1}))
    h
theorem DiamondIntegral.Section5.rationalSpectrumGraphData_point : ∀ {n m : ℕ}
  (p : Fin m → MvPolynomial.{0, 0} (Fin n) ℂ) (q : MvPolynomial.{0, 0} (Fin n) ℂ) (v : Sum.{0, 0} (Fin n) (Fin m) → ℂ),
  Membership.mem.{0, 0}
      (PrimeSpectrum.BasicConstructibleSetData.toSet.{0} (DiamondIntegral.Section5.rationalSpectrumGraphData p q))
      (DiamondIntegral.Section5.complexTupleSpectrumPoint v) ↔
    Membership.mem.{0, 0} (DiamondIntegral.Section5.rationalTupleEquationSet p q) v :=
fun {n m} p q v =>
  of_eq_true
    (Eq.trans.{1}
      (congrFun'.{1, 1}
        (congrArg.{1, 1} Iff
          (Eq.trans.{1}
            (Set.mem_sdiff._simp_1.{0}
              (PrimeSpectrum.mk.{0} (RingHom.ker.{0, 0, 0} (MvPolynomial.eval₂Hom.{0, 0, 0} (RingHom.id.{0} ℂ) v))
                (DiamondIntegral.Section5.complexTupleSpectrumPoint._proof_2 v)))
            (Eq.trans.{1}
              (congr.{1, 1}
                (congrArg.{1, 1} And
                  (Eq.trans.{1}
                    (PrimeSpectrum.mem_zeroLocus._simp_1.{0}
                      (PrimeSpectrum.mk.{0}
                        (RingHom.ker.{0, 0, 0} (MvPolynomial.eval₂Hom.{0, 0, 0} (RingHom.id.{0} ℂ) v))
                        (DiamondIntegral.Section5.complexTupleSpectrumPoint._proof_2 v))
                      (Set.range.{0, 1} fun j =>
                        HSub.hSub.{0, 0, 0}
                          (HMul.hMul.{0, 0, 0} (MvPolynomial.X.{0, 0} (Sum.inr.{0, 0} j))
                            ((MvPolynomial.rename.{0, 0, 0} Sum.inl.{0, 0}) q))
                          ((MvPolynomial.rename.{0, 0, 0} Sum.inl.{0, 0}) (p j))))
                    (Eq.trans.{1} DiamondIntegral.Section5.rationalSpectrumGraphData_point._simp_1_3.{0, 1}
                      (forall_congr.{1} fun y =>
                        Eq.trans.{1} SetLike.mem_coe._simp_1.{0, 0}
                          (Eq.trans.{1} RingHom.mem_ker._simp_1.{0, 0, 0}
                            (Eq.trans.{1}
                              (congrFun'.{1, 1}
                                (congrArg.{1, 1} Eq.{1}
                                  (Eq.trans.{1}
                                    (MvPolynomial.eval₂_sub.{0, 0, 0}
                                      (HMul.hMul.{0, 0, 0} (MvPolynomial.X.{0, 0} (Sum.inr.{0, 0} y))
                                        ((MvPolynomial.rename.{0, 0, 0} Sum.inl.{0, 0}) q))
                                      (RingHom.id.{0} ℂ) v)
                                    (congr.{1, 1}
                                      (congrArg.{1, 1} HSub.hSub.{0, 0, 0}
                                        (Eq.trans.{1} (MvPolynomial.eval₂_mul.{0, 0, 0} (RingHom.id.{0} ℂ) v)
                                          (congr.{1, 1}
