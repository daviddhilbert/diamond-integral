      (DiamondIntegral.Section5.tupleDistinctFormula.{u_1, u_2, u_3, u_5, u_6} f) v ↔
    Function.Injective.{u_3 + 1, max (u_2 + 1) (u_4 + 1)} fun i => Function.comp.{u_2 + 1, u_1 + 1, u_4 + 1} v (f i) :=
fun {L} {P} {α} {ι} {M} [Finite.{u_2 + 1} α] [Finite.{u_3 + 1} ι] [FirstOrder.Language.Structure.{u_5, u_6, u_4} L M] f
    v =>
  Eq.mpr.{0}
    (id.{0}
      (congrFun'.{1, 1}
        (congrArg.{1, 1} Iff
          (Eq.trans.{1} DiamondIntegral.Section5.tupleDistinctFormula_realize._simp_1_2.{u_5, u_6, u_4, u_1, u_3}
            (forall_congr.{u_3 + 1} fun b =>
              DiamondIntegral.Section5.tupleDistinctFormula_realize._simp_1_2.{u_5, u_6, u_4, u_1, u_3})))
        (Function.Injective.{u_3 + 1, max (u_2 + 1) (u_4 + 1)} fun i =>
          Function.comp.{u_2 + 1, u_1 + 1, u_4 + 1} v (f i))))
    {
      mp := fun h ⦃i j⦄ hij =>
        Decidable.byContradiction fun hne =>
          have hh := h i j;
          Eq.mp.{0}
            (congrArg.{1, 1} (fun _a => ¬_a)
              (propext (DiamondIntegral.Section5.tupleEqualityFormula_realize.{u_1, u_2, u_4, u_5, u_6} (f i) (f j) v)))
            (Eq.mp.{0}
              (congrArg.{1, 1} (fun _a => _a) (propext FirstOrder.Language.Formula.realize_not.{u_5, u_6, u_4, u_1}))
              (Eq.mp.{0}
                (congrArg.{max (max (u_1 + 1) (u_5 + 1)) (u_6 + 1), 1}
                  (fun _a => FirstOrder.Language.Formula.Realize.{u_5, u_6, u_4, u_1} _a v)
                  (if_neg.{max (max (u_1 + 1) (u_5 + 1)) (u_6 + 1)} hne))
