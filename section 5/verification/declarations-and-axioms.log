theorem DiamondIntegral.Section5.tupleDistinctFormula_realize.{u_1, u_2, u_3, u_4, u_5, u_6} : ∀
  {L : FirstOrder.Language.{u_5, u_6}} {P : Type u_1} {α : Type u_2} {ι : Type u_3} {M : Type u_4}
  [inst : Finite.{u_2 + 1} α] [inst_1 : Finite.{u_3 + 1} ι] [inst_2 : FirstOrder.Language.Structure.{u_5, u_6, u_4} L M]
  (f : ι → α → P) (v : P → M),
