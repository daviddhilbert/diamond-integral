        Eq.mpr.{0}
          (id.{0}
            (congrFun'.{1, 1}
              (congrArg.{1, 1} LE.le.{0}
                (Eq.trans.{1} (Set.ncard_eq_toFinset_card'.{u_1} S) (Set.toFinset_card.{u_1} S)))
              N))
          hcard⟩,
    mpr := fun a =>
      And.casesOn.{0} (motive := fun x =>
        ∀ (f : Fin (HAdd.hAdd.{0, 0, 0} N 1) → ↑S), ¬Function.Injective.{1, u_1 + 1} f) a fun hS hcard f hf =>
        have hle := Fintype.card_le_of_injective.{0, u_1} f hf;
        have hcard' :=
          Eq.mp.{0}
            (congrFun'.{1, 1}
              (congrArg.{1, 1} LE.le.{0}
                (Eq.trans.{1} (Set.ncard_eq_toFinset_card'.{u_1} S) (Set.toFinset_card.{u_1} S)))
              N)
            hcard;
        Nat.not_succ_le_self N
          (LE.le.trans.{0}
            (Eq.mp.{0}
              (congrArg.{1, 1} (fun _a => LE.le.{0} _a (Fintype.card.{u_1} ↑S))
                (Fintype.card_fin (HAdd.hAdd.{0, 0, 0} N 1)))
              hle)
