import IntegrationSection6.GammaFieldBaseReduction
import IntegrationSection6.GammaSpecialBaseReduction
import IntegrationSection6.GammaVFCodePreparation
import IntegrationSection6.GammaVFFieldClosureBases
import Section5.PolynomialPreparation
import Section5.GammaLiftRelation

/-! Lemma 5.19 (`special:term:constant:disc`) in the paper's polynomial form.

For finitely many polynomials `F_i` with coefficients in `VF(𝕊)` (the VF
parameter field generated by the base) and a base-definable `A ⊆ VF^n`, there
is a definable bijection `T : A → A♭` onto an RV-pullback such that every
composite `F_i ∘ T⁻¹` is `rv`-contractible in the sense of Definition
`defn:corr:cont`: there is a function `(F_i ∘ T⁻¹)↓ : rv(A♭) → RV_∞` with
`rv ∘ F_i ∘ T⁻¹ = (F_i ∘ T⁻¹)↓ ∘ rv`.

The bijection is a genuine special bijection whose chain is definable over the
original Gamma base. It is obtained from the same overlay preparation
`gamma_prepare_vf_row_code` used by `prepare_finite_original_base_RV_predicates`,
applied to the finite RV row code `x ↦ (rv F_i(x))_i`. The `RV` carrier is the
sorted carrier with its absorbing element, i.e. the paper's `RV_∞`. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
set_option allowUnsafeReducibility true in
attribute [local reducible] SpecialTransformations.DefinableGeometry.Space.prod
  SpecialTransformations.Section4.realSpace SpecialTransformations.Milestone0.sortEval
  SpecialTransformations.Section4.vfSpace SpecialTransformations.Section4.rvSpace
namespace DiamondIntegral.Section5.Lemma519
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters
open SpecialTransformations.Section4 SpecialTransformations.Section5
open IntegrationInACVF.Section6

variable {M : Type} [sM : LRV.Structure M] [hM : M ⊨ Axioms.ACVF]

/-- Definition `defn:corr:cont`: a VF-valued function on a set of points is
`rv`-contractible if it factors through `rv` on `rv` of its domain. The RV
image of a point `(a, t)` is `key (a, t) = (rv a, t)`. -/
def IsRVContractible {p l : ℕ} (C : Set (SpecialTransformations.Section5.Point (M := M) p l))
    (f : C → SpecialTransformations.Section5.VF (M := M)) : Prop :=
  ∃ g : SpecialTransformations.Section5.key '' C → SpecialTransformations.Section5.RV (M := M),
    ∀ x : C, SpecialTransformations.Section5.rv (f x) = g ⟨_, x.val, x.property, rfl⟩

/-- `rv`-contractibility is exactly constancy of `rv ∘ f` on points with the
same RV image. -/
theorem isRVContractible_iff {p l : ℕ}
    (C : Set (SpecialTransformations.Section5.Point (M := M) p l))
    (f : C → SpecialTransformations.Section5.VF (M := M)) :
    IsRVContractible C f ↔ ∀ x y : C, SameRV x.val y.val →
      SpecialTransformations.Section5.rv (f x) = SpecialTransformations.Section5.rv (f y) := by
  constructor
  · rintro ⟨g, hg⟩ x y hxy
    rw [hg x, hg y]
    exact congrArg g (Subtype.ext hxy)
  · intro h
    refine ⟨fun k => SpecialTransformations.Section5.rv
      (f ⟨Classical.choose k.property, (Classical.choose_spec k.property).1⟩), ?_⟩
    intro x
    apply h
    exact (Classical.choose_spec
      (⟨x.val, x.property, rfl⟩ : SpecialTransformations.Section5.key x.val ∈
        SpecialTransformations.Section5.key '' C)).2.symm

/-- The contraction is unique on `rv(C)`, as remarked after
Definition `defn:corr:cont`. -/
theorem rvContraction_unique {p l : ℕ}
    (C : Set (SpecialTransformations.Section5.Point (M := M) p l))
    (f : C → SpecialTransformations.Section5.VF (M := M))
    (g g' : SpecialTransformations.Section5.key '' C → SpecialTransformations.Section5.RV (M := M))
    (hg : ∀ x : C, SpecialTransformations.Section5.rv (f x) = g ⟨_, x.val, x.property, rfl⟩)
    (hg' : ∀ x : C, SpecialTransformations.Section5.rv (f x) = g' ⟨_, x.val, x.property, rfl⟩) :
    g = g' := by
  funext k
  obtain ⟨_, x, hx, rfl⟩ := k
  exact (hg ⟨x, hx⟩).symm.trans (hg' ⟨x, hx⟩)

/-- The finite RV row code of one polynomial: its leading term. -/
theorem polynomial_rv_row_code (B : Base (M := M)) {p : ℕ}
    (F : MvPolynomial (Fin p) (SpecialTransformations.Section5.VF (M := M)))
    (hF : ∀ d, (F.coeff d).val ∈ B.real) :
    GammaVFRowCode B p (fun z t =>
      ∀ x y : Fin p → SpecialTransformations.Section5.VF (M := M),
        (fun j => (x j).val) = z → (fun j => (y j).val) = t →
          SpecialTransformations.Section5.rv (MvPolynomial.eval x F) =
            SpecialTransformations.Section5.rv (MvPolynomial.eval y F)) := by
  let A := @PresentedSet.univ M sM (@pointSpace M sM hM p 0) B.real
  let C := @PresentedSet.univ M sM (@pointSpace M sM hM 1 0) B.real
  let P : Fin 1 → MvPolynomial (Fin p) (SpecialTransformations.Section5.VF (M := M)) := fun _ => F
  let Fm := @mvPolynomialTupleMap M sM hM B.real p 0 1 A P (fun _ d => hF d)
  let H := @Map.comp M sM _ _ _ B.real _ _ _ (@canonicalMap M sM hM 1 0 B.real C) Fm
  let g := @Map.comp M sM _ _ _ B.real _ _ _ (@pointLabels M sM hM B.real 1 (1+0)) H
  have hv (x : A) :
      (g x).val.2 0 = SpecialTransformations.Section5.rv (MvPolynomial.eval (vfAt x.val) F) := by
    change (@pointLabels M sM hM B.real 1 (1+0) (H x)).val.2 0 = _
    rw [@pointLabels_snd M sM hM B.real 1 (1+0)]
    change (canonical (Fm x).val).2 (Fin.castAdd 0 0) =
      SpecialTransformations.Section5.rv (MvPolynomial.eval (vfAt x.val) F)
    rw [canonical_new]
    rfl
  refine ⟨1, g, (gammaLogicInput B).real_map_graph g, ?_⟩
  intro x y hxy x' y' hx' hy'
  have ex : x' = x.val.1 := funext (fun j => Subtype.ext (congrFun hx' j))
  have ey : y' = y.val.1 := funext (fun j => Subtype.ext (congrFun hy' j))
  subst ex ey
  exact (hv x).symm.trans ((congrArg (fun q => q.val.2 0) hxy).trans (hv y))

/-- **Lemma 5.19** (`special:term:constant:disc`), polynomial form.
Coefficients lie in `VF(𝕊)`, the VF field generated by the base parameters.
The preparation `T : A → A♭` is a special bijection, definable over the
original Gamma base, onto an RV-pullback `A♭`, and each `F_i ∘ T⁻¹` is
`rv`-contractible. The temporary enlarged set `R ⊇ S ∪ B.real` only carries
the internal names of the generated coefficient field. -/
theorem lemma_5_19 {κ : Cardinal}
    (hκ : Cardinal.aleph0 < κ) (hs : Saturated M κ) (h00 : M ⊨ Axioms.ACVF00)
    (B : Base (M := M)) (hsmall : Cardinal.mk B.real < κ)
    {S : Set M} {p : ℕ} (A : DefSet (M := M) S p 0)
    (hA : GammaSetDefinable B (carrier A))
    {ι : Type} [Finite ι] (F : ι → MvPolynomial (Fin p) (SpecialTransformations.Section5.VF (M := M)))
    (hF : ∀ i d, (F i).coeff d ∈ vfParameterField B.real) :
    ∃ R : Set M, ∃ hSR : S ⊆ R, ∃ _hBR : B.real ⊆ R,
      ∃ l : ℕ, ∃ C : DefSet (M := M) R p l,
      ∃ T : SpecialBijection (SpecialTransformations.Section5.extendBase A hSR) C,
      GammaChainDefinable B T.chain ∧ IsRVPullback (carrier C) ∧
      ∀ i, IsRVContractible (carrier C)
        (fun x => MvPolynomial.eval (vfAt (T.inverseMap x).val) (F i)) := by
  let _ : Fintype ι := Fintype.ofFinite ι
  let CF := vfFieldNamedBase B
  let R := S ∪ CF.real
  have hSR : S ⊆ R := Set.subset_union_left
  let A' := SpecialTransformations.Section5.extendBase A hSR
  have hA' : GammaSetDefinable CF (carrier A') :=
    hA.mono Set.subset_union_left (Set.Subset.refl _)
  have hcoeff : ∀ i d, ((F i).coeff d).val ∈ CF.real :=
    fun i d => ((vfFieldNamedBase_field B).mem_iff _).mp (hF i d)
  let P : (Fin p → M) → (Fin p → M) → Prop := fun z t => ∀ i : ι,
    ∀ x y : Fin p → SpecialTransformations.Section5.VF (M := M),
      (fun j => (x j).val) = z → (fun j => (y j).val) = t →
        SpecialTransformations.Section5.rv (MvPolynomial.eval x (F i)) =
          SpecialTransformations.Section5.rv (MvPolynomial.eval y (F i))
  have hCode : GammaVFRowCode CF p P :=
    (GammaVFRowCode.finset Finset.univ _
      (fun i _ => polynomial_rv_row_code CF (F i) (hcoeff i))).mono
        (fun _ _ h i => h i (Finset.mem_univ i))
  obtain ⟨l, C, T, hTC, hC, hrows⟩ := gamma_prepare_vf_row_code (B := CF) hs h00
    (vfFieldNamedBase_small B hκ hsmall) (vfFieldNamedBase_field B)
    Set.subset_union_right A' hA' P hCode
  have hT : GammaChainDefinable B T.chain :=
    (vfFieldBaseReduction B).chainDefinable T.chain hTC
  refine ⟨R, hSR, (fun _ hc => Or.inr (Or.inl hc)), l, C, T, hT, hC, fun i => ?_⟩
  apply (isRVContractible_iff _ _).mpr
  intro x y hxy
  exact hrows x y hxy i _ _ rfl rfl

/-- Lemma 5.19 with coefficients named directly in the base. -/
theorem lemma_5_19_base_coefficients {κ : Cardinal}
    (hκ : Cardinal.aleph0 < κ) (hs : Saturated M κ) (h00 : M ⊨ Axioms.ACVF00)
    (B : Base (M := M)) (hsmall : Cardinal.mk B.real < κ)
    {S : Set M} {p : ℕ} (A : DefSet (M := M) S p 0)
    (hA : GammaSetDefinable B (carrier A))
    {ι : Type} [Finite ι] (F : ι → MvPolynomial (Fin p) (SpecialTransformations.Section5.VF (M := M)))
    (hF : ∀ i d, ((F i).coeff d).val ∈ B.real) :
    ∃ R : Set M, ∃ hSR : S ⊆ R, ∃ _hBR : B.real ⊆ R,
      ∃ l : ℕ, ∃ C : DefSet (M := M) R p l,
      ∃ T : SpecialBijection (SpecialTransformations.Section5.extendBase A hSR) C,
      GammaChainDefinable B T.chain ∧ IsRVPullback (carrier C) ∧
      ∀ i, IsRVContractible (carrier C)
        (fun x => MvPolynomial.eval (vfAt (T.inverseMap x).val) (F i)) :=
  lemma_5_19 hκ hs h00 B hsmall A hA F (fun i d => Subfield.subset_closure (hF i d))

/-- The domain of `T` in Lemma 5.19 is literally the original set `A`; only
its definability base is enlarged. -/
theorem extendBase_carrier {S R : Set M} {p : ℕ} (A : DefSet (M := M) S p 0) (hSR : S ⊆ R) :
    carrier (SpecialTransformations.Section5.extendBase A hSR) = carrier A := rfl

end DiamondIntegral.Section5.Lemma519
