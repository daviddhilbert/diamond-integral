import «section 4».BlowupRelation
import «section 4».RVTaggedCoproductClasses

/-! Notation 4.17 (`relative:annular:ideal`): the manuscript generator family of
`J_var`.

An admissible datum is a doubly bounded chart `U = (U, f, ω)` of degree `1+k`,
a coordinate `j` with `pr_{~j} ↾ f(U)` finite-to-one, and an aperture `τ`
(an original-base definable nonzero RV function with `0 ≤ vrv τ ≤ Δ`). The
relative annular object `U^{τ,j}` is the separately tagged union of the shell
`{(u,s) : 0 < vrv s ≤ vrv τ(u)}` and the endpoint graph of `τ`, with structural
coordinate `s f_j(u)` in position `j` (`boundedCoproduct` of `shellBounded` and
`endpointBounded`). The manuscript ideal is generated by
`[U^{τ,j}] - [U]`. Every such generator lies in the implemented ideal
`FunctionalApertureCompatibility.ideal`. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters
open SpecialTransformations.Section4 SpecialTransformations.DefinableGeometry
open DiamondIntegral.Section3

namespace DiamondIntegral.Section4.RelativeAnnularGenerators
open DiamondIntegral.Section4 DiamondIntegral.Section4.RVMeasuredCharts
open DiamondIntegral.Section4.AnnularBlowup DiamondIntegral.Section4.BlowupChart
open DiamondIntegral.Section4.BlowupRelation

variable {M : Type} [LRV.Structure M] [hM : M ⊨ Axioms.ACVF] {B : Base (M := M)}

/-- An admissible datum for Notation 4.17. -/
structure AnnularDatum (B : Base (M := M)) (k : ℕ) where
  chart : Chart B (1 + k)
  coordinate : Fin (1 + k)
  finite : InactiveFinite chart coordinate
  aperture : Aperture chart
  bounded : RVMeasuredBounds.DomainBounded chart

variable {k : ℕ}

/-- The source object `U`. -/
def AnnularDatum.source (D : AnnularDatum B k) : RVBoundedCharts.BoundedChart B (1 + k) :=
  sourceBounded D.chart D.bounded

/-- The relative annular object `U^{τ,j}`: the separately tagged union of the
shell and the endpoint. -/
def AnnularDatum.annularObject (D : AnnularDatum B k) : RVBoundedCharts.BoundedChart B (1 + k) :=
  RVTaggedCoproductProperties.boundedCoproduct
    (shellBounded D.chart D.coordinate D.finite D.aperture D.bounded)
    (endpointBounded D.chart D.coordinate D.finite D.aperture D.bounded)

/-- The manuscript generator `[U^{τ,j}] - [U]`. -/
def AnnularDatum.generator (D : AnnularDatum B k) : RVBoundedRing.Ring B :=
  RVBoundedRing.objectClass D.annularObject - RVBoundedRing.objectClass D.source

theorem AnnularDatum.generator_eq (D : AnnularDatum B k) :
    D.generator = RVBoundedRing.objectClass (shellBounded D.chart D.coordinate D.finite D.aperture D.bounded) +
      RVBoundedRing.objectClass (endpointBounded D.chart D.coordinate D.finite D.aperture D.bounded) -
      RVBoundedRing.objectClass (sourceBounded D.chart D.bounded) := by
  rw [AnnularDatum.generator, AnnularDatum.annularObject, RVTaggedCoproductClasses.bounded_coproduct_class]
  rfl

variable (B) in
/-- The ideal generated by the manuscript generators of Notation 4.17. -/
def manuscriptIdeal : Ideal (RVBoundedRing.Ring B) :=
  Ideal.span {x | ∃ k, ∃ D : AnnularDatum B k, x = D.generator}

/-- Every manuscript generator lies in the implemented ideal. -/
theorem generator_mem_ideal (D : AnnularDatum B k) :
    D.generator ∈ FunctionalApertureCompatibility.ideal B := by
  rw [AnnularDatum.generator_eq]
  exact blowup_mem_ideal D.chart D.coordinate D.finite D.aperture D.bounded

theorem manuscriptIdeal_le : manuscriptIdeal B ≤ FunctionalApertureCompatibility.ideal B := by
  apply Ideal.span_le.mpr
  rintro x ⟨k, D, rfl⟩
  exact generator_mem_ideal D

/-- Each manuscript generator is the relation of the Section 4 presentation of
its datum. -/
theorem AnnularDatum.generator_eq_relation (D : AnnularDatum B k) :
    D.generator = (presentation D.chart D.coordinate D.finite D.aperture D.bounded).relation :=
  D.generator_eq.trans (blowup_relation D.chart D.coordinate D.finite D.aperture D.bounded)

/-- Lemma 4.18 for the manuscript ideal: it is homogeneous. -/
theorem manuscriptIdeal_homogeneous :
    (manuscriptIdeal B).IsHomogeneous (RVBoundedGrading.gradedPiece B) := by
  apply Ideal.homogeneous_span
  rintro x ⟨k, D, rfl⟩
  rw [D.generator_eq_relation]
  exact ⟨1 + k, (presentation D.chart D.coordinate D.finite D.aperture D.bounded).toCoordinate.relation_mem_degree⟩

/-- Lemma 4.18 for the manuscript ideal: volume forgetting kills it. -/
theorem manuscriptIdeal_le_forget_kernel :
    manuscriptIdeal B ≤ RingHom.ker (RVOrdinaryMaps.boundedForget B) :=
  manuscriptIdeal_le.trans (FunctionalApertureCompatibility.ideal_le_forget_kernel B)

/-- Lemma 4.18 for the manuscript ideal: it meets the degree-zero subring
trivially. -/
theorem manuscript_quotient_injective_on_degree_zero :
    Set.InjOn (Ideal.Quotient.mk (manuscriptIdeal B)) (RVBoundedGrading.gradedPiece B 0) :=
  (RVBoundedGrading.gradingCoaction B).quotient_injective_on_zero (manuscriptIdeal B)
    (manuscriptIdeal_le.trans ((FunctionalApertureCompatibility.ideal_le_coordinate_ideal B).trans
      (VariableApertureCompatibility.ideal_le_zeroProjection_kernel B)))

/-- Lemma 4.18 for the manuscript ideal: its image in the full measured RV ring
lies in `(P)`. -/
theorem manuscriptIdeal_maps_into_p :
    manuscriptIdeal B ≤
      (Ideal.span {RVMeasuredSpecialClasses.pClass B}).comap (RVBoundedMaps.forget B) :=
  manuscriptIdeal_le.trans (VariableApertureMeasuredComparison.functional_ideal_maps_into_p B)

/-- Lemma 4.18 for the manuscript ideal: the bounded retraction kills it, so it
factors through `B / J_var`. -/
theorem manuscript_section4_compatibility (hc : CanonicalStructure.IsCanonical (M := M))
    (h00 : M ⊨ Axioms.ACVF00) (linear : Section2.GammaPiecewiseRationalAffineInput (M := M))
    {κ : Cardinal} (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) :
    manuscriptIdeal B ≤ RingHom.ker
      (RVT001OrdinaryDescent.boundedEvaluation h00 linear hκ hs B hr hγ hΓ
        (Section3T001Integration.ordinary (hc := hc) hκ hs h00 hr hγ hΓ) EulerKind.bounded) :=
  manuscriptIdeal_le.trans (FunctionalApertureCompatibility.section4_compatibility hc h00 linear hκ hs B hr hγ hΓ)

end DiamondIntegral.Section4.RelativeAnnularGenerators
