import «section 4».RVTranslationEvaluation
import «section 4».RVBalancedGradings
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal

/-! Homogeneous ideals generated by compensated translation differences
are annihilated by the actual evaluations. These are evaluation ideals;
no equality or inclusion with the RV comparison kernel is assumed. -/

set_option autoImplicit false
noncomputable section
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3
open SpecialTransformations.Section3.GammaParameters
open scoped TensorProduct

namespace DiamondIntegral.Section4.RVTranslationIdeals
open RVBalancedGradings
variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF]

def measuredGenerator (B : Base (M := M)) {m n : ℕ} (r : RVMeasuredCharts.RESChart B m)
    (a : Fin n → Values.Gamma (M := M)) (ha : ∀ i, GammaDefinableClosureAtBase B (a i))
    (c : GammaWeightedCharts.Chart B n) : RVFiniteBalancedTensor.Source B :=
  RESChartRing.objectClass r ⊗ₜ[GammaFiniteRVPresentation.ChartRing B] GammaRVChartPresentation.objectClass c -
    RESChartRing.objectClass r ⊗ₜ[GammaFiniteRVPresentation.ChartRing B]
      GammaRVChartPresentation.objectClass (GammaTranslationCharts.translatedChart B a ha c)

def boundedGenerator (B : Base (M := M)) {m n : ℕ} (r : RVMeasuredCharts.RESChart B m)
    (a : Fin n → Values.Gamma (M := M)) (ha : ∀ i, GammaDefinableClosureAtBase B (a i))
    (c : GammaBoundedRVCharts.BoundedChart B n) : RVBoundedBalancedTensor.Source B :=
  RESChartRing.objectClass r ⊗ₜ[GammaFiniteRVPresentation.ChartRing B] GammaBoundedRVPresentation.objectClass c -
    RESChartRing.objectClass r ⊗ₜ[GammaFiniteRVPresentation.ChartRing B]
      GammaBoundedRVPresentation.objectClass (GammaBoundedTranslationCharts.translatedChart B a ha c)

def measuredIdeal (B : Base (M := M)) : Ideal (RVFiniteBalancedTensor.Source B) :=
  Ideal.span {x | ∃ m n, ∃ r : RVMeasuredCharts.RESChart B m,
    ∃ a : Fin n → Values.Gamma (M := M), ∃ ha : ∀ i, GammaDefinableClosureAtBase B (a i),
    ∃ c : GammaWeightedCharts.Chart B n, x = measuredGenerator B r a ha c}

def boundedIdeal (B : Base (M := M)) : Ideal (RVBoundedBalancedTensor.Source B) :=
  Ideal.span {x | ∃ m n, ∃ r : RVMeasuredCharts.RESChart B m,
    ∃ a : Fin n → Values.Gamma (M := M), ∃ ha : ∀ i, GammaDefinableClosureAtBase B (a i),
    ∃ c : GammaBoundedRVCharts.BoundedChart B n, x = boundedGenerator B r a ha c}

theorem measuredIdeal_homogeneous (B : Base (M := M)) :
    (measuredIdeal B).IsHomogeneous (measuredPiece B) := by
  apply Ideal.homogeneous_span
  rintro x ⟨m, n, r, a, ha, c, rfl⟩
  exact ⟨m + n, (measuredPiece B (m + n)).sub_mem
    (measured_tmul_mem B (RESRingCoaction.class_mem_gradedPiece B r) (GammaRVGrading.class_mem B c))
    (measured_tmul_mem B (RESRingCoaction.class_mem_gradedPiece B r) (GammaRVGrading.class_mem B _))⟩

theorem boundedIdeal_homogeneous (B : Base (M := M)) :
    (boundedIdeal B).IsHomogeneous (boundedPiece B) := by
  apply Ideal.homogeneous_span
  rintro x ⟨m, n, r, a, ha, c, rfl⟩
  exact ⟨m + n, (boundedPiece B (m + n)).sub_mem
    (bounded_tmul_mem B (RESRingCoaction.class_mem_gradedPiece B r) (GammaBoundedRVGrading.class_mem B c))
    (bounded_tmul_mem B (RESRingCoaction.class_mem_gradedPiece B r) (GammaBoundedRVGrading.class_mem B _))⟩

theorem measuredIdeal_le_evaluation_ker (h00 : M ⊨ Axioms.ACVF00)
    (linear : Section2.GammaPiecewiseRationalAffineInput (M := M)) {κ : Cardinal}
    (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) (k : EulerKind) :
    measuredIdeal B ≤ RingHom.ker (RVFiniteBalancedTensor.evaluation h00 linear hκ hs B hr hγ hΓ k).toRingHom := by
  apply Ideal.span_le.mpr
  rintro x ⟨m, n, r, a, ha, c, rfl⟩
  exact RVTranslationEvaluation.measured_difference h00 linear hκ hs B hr hγ hΓ k (RESChartRing.objectClass r) a ha c

theorem boundedIdeal_le_evaluation_ker (hc : CanonicalStructure.IsCanonical (M := M))
    (h00 : M ⊨ Axioms.ACVF00) (linear : Section2.GammaPiecewiseRationalAffineInput (M := M)) {κ : Cardinal}
    (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) (k : EulerKind) :
    boundedIdeal B ≤ RingHom.ker (RVBoundedBalancedTensor.evaluation hc h00 linear hκ hs B hr hγ hΓ k).toRingHom := by
  apply Ideal.span_le.mpr
  rintro x ⟨m, n, r, a, ha, c, rfl⟩
  exact RVTranslationEvaluation.bounded_difference hc h00 linear hκ hs B hr hγ hΓ k (RESChartRing.objectClass r) a ha c

end DiamondIntegral.Section4.RVTranslationIdeals
