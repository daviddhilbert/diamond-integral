import Mathlib.RingTheory.FreeCommRing
import Mathlib.Algebra.Group.Subgroup.Finsupp

/-! A ring presented by actual objects is additively generated by their
classes when units and products are again actual object classes. -/

set_option autoImplicit false
noncomputable section
open Classical

namespace DiamondIntegral.Section4.ObjectClassAdditiveGeneration
variable {Obj R : Type*} [CommRing R]

structure Presentation (Obj R : Type*) [CommRing R] where
  objectClass : Obj → R
  unit : Obj
  class_unit : objectClass unit = 1
  product : Obj → Obj → Obj
  class_product : ∀ a b, objectClass (product a b) = objectClass a * objectClass b
  free : FreeCommRing Obj →+* R
  free_of : ∀ a, free (FreeCommRing.of a) = objectClass a
  surjective : Function.Surjective free

def span (P : Presentation Obj R) : AddSubgroup R := AddSubgroup.closure (Set.range P.objectClass)

theorem class_mem (P : Presentation Obj R) (a : Obj) : P.objectClass a ∈ span P := AddSubgroup.subset_closure ⟨a, rfl⟩

theorem mul_mem (P : Presentation Obj R) {x y : R} (hx : x ∈ span P) (hy : y ∈ span P) : x * y ∈ span P := by
  induction hx using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, rfl⟩ := hx
    induction hy using AddSubgroup.closure_induction with
    | mem y hy => obtain ⟨b, rfl⟩ := hy; rw [← P.class_product]; exact class_mem P _
    | zero => simpa only [mul_zero] using (span P).zero_mem
    | add y z _ _ hy hz => simpa only [mul_add] using (span P).add_mem hy hz
    | neg y _ hy => simpa only [mul_neg] using (span P).neg_mem hy
  | zero => simpa only [zero_mul] using (span P).zero_mem
  | add x z _ _ hx hz => simpa only [add_mul] using (span P).add_mem hx hz
  | neg x _ hx => simpa only [neg_mul] using (span P).neg_mem hx

theorem mem_span (P : Presentation Obj R) (x : R) : x ∈ span P := by
  obtain ⟨p, rfl⟩ := P.surjective x
  induction p using FreeCommRing.induction_on with
  | neg_one => rw [map_neg, map_one, ← P.class_unit]; exact (span P).neg_mem (class_mem P _)
  | of a => rw [P.free_of]; exact class_mem P _
  | add p q hp hq => simpa only [map_add] using (span P).add_mem hp hq
  | mul p q hp hq => simpa only [map_mul] using mul_mem P hp hq

theorem hom_ext (P : Presentation Obj R) {G : Type*} [AddCommGroup G] (f g : R →+ G)
    (h : ∀ a, f (P.objectClass a) = g (P.objectClass a)) : f = g := by
  let T : AddSubgroup R := {
    carrier := {x | f x = g x}
    zero_mem' := by simp only [map_zero, Set.mem_setOf_eq]
    add_mem' := by intro x y hx hy; change f (x + y) = g (x + y); rw [map_add, map_add, hx, hy]
    neg_mem' := by intro x hx; change f (-x) = g (-x); rw [map_neg, map_neg, hx] }
  have hs : span P ≤ T := (AddSubgroup.closure_le T).mpr (by rintro _ ⟨a, rfl⟩; exact h a)
  exact AddMonoidHom.ext (fun x => hs (mem_span P x))

end DiamondIntegral.Section4.ObjectClassAdditiveGeneration
