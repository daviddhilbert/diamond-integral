module

public import Mathlib.GroupTheory.Perm.Fin

/-! A finite permutation is generated by permutations of the tail and
the transposition of the first two coordinates. -/

@[expose] public noncomputable section
set_option autoImplicit false

namespace DiamondIntegral.Section4.FinitePermutationGeneration

open Equiv

def lift {n : ℕ} (e : Perm (Fin n)) : Perm (Fin (n + 1)) :=
  Perm.decomposeFin.symm (0, e)

@[simp] theorem lift_zero {n : ℕ} (e : Perm (Fin n)) : lift e 0 = 0 := by
  simp [lift]

@[simp] theorem lift_succ {n : ℕ} (e : Perm (Fin n)) (i : Fin n) :
    lift e i.succ = (e i).succ := by
  simp [lift]

theorem decompose {n : ℕ} (p : Fin (n + 1)) (e : Perm (Fin n)) :
    Perm.decomposeFin.symm (p, e) = swap 0 p * lift e := by
  ext i
  refine Fin.cases ?_ (fun j => ?_) i
  · simp
  · simp

theorem all_mem {n : ℕ} (S : Subgroup (Perm (Fin (n + 2))))
    (htail : ∀ e : Perm (Fin (n + 1)), lift e ∈ S)
    (hfront : swap (0 : Fin (n + 2)) (0 : Fin (n + 1)).succ ∈ S) :
    ∀ e, e ∈ S := by
  have hswap : ∀ p : Fin (n + 2), swap 0 p ∈ S := by
    intro p
    refine Fin.cases ?_ (fun j => ?_) p
    · rw [swap_self]
      change (1 : Perm (Fin (n + 2))) ∈ S
      exact S.one_mem
    · let τ := lift (swap (0 : Fin (n + 1)) j)
      have hτ : τ ∈ S := htail _
      have hτ0 : τ 0 = 0 := lift_zero _
      have hτ1 : τ (0 : Fin (n + 1)).succ = j.succ := by
        change (lift (swap (0 : Fin (n + 1)) j)) (0 : Fin (n + 1)).succ = j.succ
        rw [lift_succ, swap_apply_left]
      have hc := S.mul_mem (S.mul_mem hτ hfront) (S.inv_mem hτ)
      rw [← Equiv.swap_apply_apply, hτ0, hτ1] at hc
      exact hc
  intro e
  obtain ⟨⟨p, t⟩, rfl⟩ := Perm.decomposeFin.symm.surjective e
  rw [decompose]
  exact S.mul_mem (hswap p) (htail t)

end DiamondIntegral.Section4.FinitePermutationGeneration
