import «section 4».GammaChartPresentation
import «section 4».GammaBoundedSpecialization
import «section 4».GammaBoundedProducts

/-! The subring generated by actual bounded weighted charts has a
constructed homomorphism to the actual bounded restricted polynomial
source. The proof first establishes the image bound on every generator,
then uses subring closure and the proved injective bounded-source map.
This remains an auxiliary chart presentation, not an asserted tensor map. -/

set_option autoImplicit false
noncomputable section
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3
open SpecialTransformations.Section3.GammaParameters

namespace DiamondIntegral.Section4.GammaBoundedChartMap
open GammaWeightedCharts GammaChartPresentation GammaBoundedProducts GammaBoundedPolynomial

variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF]

def boundedGenerators (B : Base (M := M)) : Set (ChartRing B) :=
  {x | ∃ n, ∃ a : Chart B n, DomainBounded a.support ∧
    x = Ideal.Quotient.mk (relationIdeal B) (symbol a)}

def boundedChartSubring (B : Base (M := M)) : Subring (ChartRing B) := Subring.closure (boundedGenerators B)

def boundedClass {B : Base (M := M)} {n : ℕ} (a : Chart B n) (ha : DomainBounded a.support) : boundedChartSubring B :=
  ⟨Ideal.Quotient.mk (relationIdeal B) (symbol a), Subring.subset_closure ⟨n, a, ha, rfl⟩⟩

def boundedRangeEquiv (B : Base (M := M)) (k : EulerKind) :
    sourceRing B k ≃+* (toUnbounded B k).range :=
  RingEquiv.ofBijective (toUnbounded B k).rangeRestrict
    ⟨(fun _ _ h => toUnbounded_injective B k
      (congrArg (fun q : (toUnbounded B k).range => q.val) h)),
      (toUnbounded B k).rangeRestrict_surjective⟩

theorem boundedGenerator_image (hc : CanonicalStructure.IsCanonical (M := M))
    (h00 : M ⊨ Axioms.ACVF00) (linear : Section2.GammaPiecewiseRationalAffineInput (M := M))
    {κ : Cardinal} (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) (k : EulerKind) :
    ∀ x ∈ boundedGenerators B, GammaChartPresentation.interpretation h00 linear hκ hs B hr hγ hΓ k x ∈
      (toUnbounded B k).range := by
  rintro x ⟨n, a, ha, rfl⟩
  refine ⟨GammaBoundedObjectPolynomial.objectPolynomial hc h00 linear hκ hs B hr hγ hΓ k n
    a.support a.support_definable a.normalizedVolume a.normalizedVolume_definable ha, ?_⟩
  rw [interpretation_symbol]
  exact GammaBoundedObjectPolynomial.toUnbounded_objectPolynomial hc h00 linear hκ hs B hr hγ hΓ k n
    a.support a.support_definable a.normalizedVolume a.normalizedVolume_definable ha

theorem bounded_image (hc : CanonicalStructure.IsCanonical (M := M))
    (h00 : M ⊨ Axioms.ACVF00) (linear : Section2.GammaPiecewiseRationalAffineInput (M := M))
    {κ : Cardinal} (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) (k : EulerKind) (p : boundedChartSubring B) :
    GammaChartPresentation.interpretation h00 linear hκ hs B hr hγ hΓ k p.val ∈ (toUnbounded B k).range := by
  have hle : boundedChartSubring B ≤ (toUnbounded B k).range.comap
      (GammaChartPresentation.interpretation h00 linear hκ hs B hr hγ hΓ k) :=
    Subring.closure_le.mpr (boundedGenerator_image hc h00 linear hκ hs B hr hγ hΓ k)
  exact hle p.property

def interpretationToRange (hc : CanonicalStructure.IsCanonical (M := M))
    (h00 : M ⊨ Axioms.ACVF00) (linear : Section2.GammaPiecewiseRationalAffineInput (M := M))
    {κ : Cardinal} (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) (k : EulerKind) :
    boundedChartSubring B →+* (toUnbounded B k).range :=
  ((GammaChartPresentation.interpretation h00 linear hκ hs B hr hγ hΓ k).comp (boundedChartSubring B).subtype).codRestrict
    (toUnbounded B k).range (bounded_image hc h00 linear hκ hs B hr hγ hΓ k)

def interpretation (hc : CanonicalStructure.IsCanonical (M := M))
    (h00 : M ⊨ Axioms.ACVF00) (linear : Section2.GammaPiecewiseRationalAffineInput (M := M))
    {κ : Cardinal} (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) (k : EulerKind) : boundedChartSubring B →+* sourceRing B k :=
  (boundedRangeEquiv B k).symm.toRingHom.comp (interpretationToRange hc h00 linear hκ hs B hr hγ hΓ k)

theorem toUnbounded_interpretation (hc : CanonicalStructure.IsCanonical (M := M))
    (h00 : M ⊨ Axioms.ACVF00) (linear : Section2.GammaPiecewiseRationalAffineInput (M := M))
    {κ : Cardinal} (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) (k : EulerKind) (p : boundedChartSubring B) :
    toUnbounded B k (interpretation hc h00 linear hκ hs B hr hγ hΓ k p) =
      GammaChartPresentation.interpretation h00 linear hκ hs B hr hγ hΓ k p.val := by
  have h := (boundedRangeEquiv B k).apply_symm_apply (interpretationToRange hc h00 linear hκ hs B hr hγ hΓ k p)
  exact congrArg (fun q : (toUnbounded B k).range => q.val) h

theorem interpretation_boundedClass (hc : CanonicalStructure.IsCanonical (M := M))
    (h00 : M ⊨ Axioms.ACVF00) (linear : Section2.GammaPiecewiseRationalAffineInput (M := M))
    {κ : Cardinal} (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) (k : EulerKind) {n : ℕ} (a : Chart B n) (ha : DomainBounded a.support) :
    interpretation hc h00 linear hκ hs B hr hγ hΓ k (boundedClass a ha) =
      GammaBoundedObjectPolynomial.objectPolynomial hc h00 linear hκ hs B hr hγ hΓ k n
        a.support a.support_definable a.normalizedVolume a.normalizedVolume_definable ha := by
  apply toUnbounded_injective B k
  have h := GammaBoundedObjectPolynomial.toUnbounded_objectPolynomial hc h00 linear hκ hs B hr hγ hΓ k n
    a.support a.support_definable a.normalizedVolume a.normalizedVolume_definable ha
  exact (toUnbounded_interpretation hc h00 linear hκ hs B hr hγ hΓ k (boundedClass a ha)).trans
    ((interpretation_symbol h00 linear hκ hs B hr hγ hΓ k a).trans h.symm)

def specialize (hc : CanonicalStructure.IsCanonical (M := M))
    (h00 : M ⊨ Axioms.ACVF00) (linear : Section2.GammaPiecewiseRationalAffineInput (M := M))
    {κ : Cardinal} (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) (k : EulerKind) {R : Type*} [CommRing R] (T : R) :
    boundedChartSubring B →+* R :=
  (GammaBoundedSpecialization.specialize B k T).comp (interpretation hc h00 linear hκ hs B hr hγ hΓ k)

theorem specialize_boundedClass (hc : CanonicalStructure.IsCanonical (M := M))
    (h00 : M ⊨ Axioms.ACVF00) (linear : Section2.GammaPiecewiseRationalAffineInput (M := M))
    {κ : Cardinal} (hκ : Cardinal.aleph0 ≤ κ) (hs : Saturated M κ)
    (B : Base (M := M)) (hr : Cardinal.mk B.real < κ) (hγ : Cardinal.mk B.gamma < κ)
    (hΓ : Section2.NontrivialDefinableGamma B) (k : EulerKind) {n : ℕ} (a : Chart B n) (ha : DomainBounded a.support)
    {R : Type*} [CommRing R] (T : R) :
    specialize hc h00 linear hκ hs B hr hγ hΓ k T (boundedClass a ha) =
      (GammaIteratedIntegral.integrateAll h00 hκ hs B hr hγ k n
        (GammaIndicators.indicatorFamily B a.support a.support_definable) : R) * T ^ n := by
  have h := interpretation_boundedClass hc h00 linear hκ hs B hr hγ hΓ k a ha
  exact (congrArg (GammaBoundedSpecialization.specialize B k T) h).trans
    (GammaBoundedSpecialization.specialize_object hc h00 linear hκ hs B hr hγ hΓ k n
      a.support a.support_definable a.normalizedVolume a.normalizedVolume_definable ha T)

end DiamondIntegral.Section4.GammaBoundedChartMap
