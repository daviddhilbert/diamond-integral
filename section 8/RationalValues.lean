import Mathlib.Algebra.Order.Group.Basic
import Mathlib.Algebra.Order.Monoid.Unbundled.Pow
import Mathlib.Data.Rat.Cast.Defs
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Linarith
import Mathlib.Data.Set.Finite.Basic
import Mathlib.Order.Interval.Finset.Defs
import Mathlib.Data.Int.Interval

/-! Rational values relative to a uniformizer.

In Section 8 the base is `ℂ((t))`, whose value group is generated by the value `π` of `t`, and
`Γ = ℚ` means that every definable value has a power in that group. The value group of the
formalization is an abstract multiplicative ordered group, so this file attaches to an element
`γ` with `γ ^ n = π ^ z`, `n ≠ 0`, the rational number `z / n`. This is the exponent of `T` in
the piecewise retraction `h_m`, and it gives the lattice `m⁻¹ℤ`. -/

noncomputable section
open Classical

namespace DiamondIntegral.Section8

variable {Γ : Type*} [CommGroup Γ]

/-- `γ` has a nonzero power in the group generated by `π`. -/
def IsRationalValue (π γ : Γ) : Prop := ∃ n : ℕ, n ≠ 0 ∧ ∃ z : ℤ, γ ^ n = π ^ z

/-- `γ` is in the lattice `m⁻¹ℤ`: `γ ^ m` is a power of `π`. -/
def InLattice (π : Γ) (m : ℕ) (γ : Γ) : Prop := ∃ z : ℤ, γ ^ m = π ^ z

theorem InLattice.isRationalValue {π γ : Γ} {m : ℕ} (hm : m ≠ 0) (h : InLattice π m γ) :
    IsRationalValue π γ := ⟨m, hm, h⟩

theorem IsRationalValue.mul {π γ δ : Γ} (hγ : IsRationalValue π γ) (hδ : IsRationalValue π δ) :
    IsRationalValue π (γ * δ) := by
  obtain ⟨n, hn, z, h⟩ := hγ
  obtain ⟨n', hn', z', h'⟩ := hδ
  refine ⟨n * n', Nat.mul_ne_zero hn hn', z * n' + z' * n, ?_⟩
  rw [mul_pow, pow_mul, h, mul_comm n n', pow_mul, h', zpow_add, zpow_mul, zpow_mul, zpow_natCast,
    zpow_natCast]

theorem IsRationalValue.inv {π γ : Γ} (hγ : IsRationalValue π γ) : IsRationalValue π γ⁻¹ := by
  obtain ⟨n, hn, z, h⟩ := hγ
  exact ⟨n, hn, -z, by rw [inv_pow, h, zpow_neg]⟩

theorem InLattice.mul {π : Γ} {m : ℕ} {γ δ : Γ} (hγ : InLattice π m γ) (hδ : InLattice π m δ) :
    InLattice π m (γ * δ) := by
  obtain ⟨z, h⟩ := hγ
  obtain ⟨z', h'⟩ := hδ
  exact ⟨z + z', by rw [mul_pow, h, h', zpow_add]⟩

theorem InLattice.inv {π : Γ} {m : ℕ} {γ : Γ} (hγ : InLattice π m γ) : InLattice π m γ⁻¹ := by
  obtain ⟨z, h⟩ := hγ
  exact ⟨-z, by rw [inv_pow, h, zpow_neg]⟩

theorem inLattice_one (π : Γ) (m : ℕ) : InLattice π m (1 : Γ) := ⟨0, by simp⟩

/-- The rational value `z / n` of `γ`, where `γ ^ n = π ^ z`; `0` if there is none. -/
def ratValue (π γ : Γ) : ℚ :=
  if h : IsRationalValue π γ then ((h.choose_spec.2.choose : ℤ) : ℚ) / (h.choose : ℕ) else 0

section
variable [LinearOrder Γ] [IsOrderedMonoid Γ] {π : Γ} (hπ : 1 < π)
include hπ

theorem zpow_uniformizer_injective : Function.Injective (fun z : ℤ => π ^ z) :=
  (zpow_right_strictMono hπ).injective

theorem ratValue_eq {γ : Γ} {n : ℕ} (hn : n ≠ 0) {z : ℤ} (h : γ ^ n = π ^ z) :
    ratValue π γ = (z : ℚ) / n := by
  unfold ratValue
  split_ifs with hr
  swap
  · exact absurd ⟨n, hn, z, h⟩ hr
  set n' := hr.choose with hn'
  have hn'0 : n' ≠ 0 := hr.choose_spec.1
  set z' := hr.choose_spec.2.choose with hz'
  have h' : γ ^ n' = π ^ z' := hr.choose_spec.2.choose_spec
  have key : π ^ (z' * n) = π ^ (z * n') := by
    rw [zpow_mul, ← h', zpow_mul, ← h, zpow_natCast, zpow_natCast, ← pow_mul, ← pow_mul, mul_comm]
  have hz : z' * n = z * n' := zpow_uniformizer_injective hπ key
  have hnq : (n : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hn
  have hn'q : (n' : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hn'0
  rw [div_eq_div_iff hn'q hnq]
  exact_mod_cast hz

theorem ratValue_one : ratValue π (1 : Γ) = 0 := by
  rw [ratValue_eq hπ one_ne_zero (z := 0) (by simp)]; simp

theorem ratValue_uniformizer : ratValue π π = 1 := by
  rw [ratValue_eq hπ one_ne_zero (z := 1) (by simp)]; simp

theorem ratValue_zpow (z : ℤ) : ratValue π (π ^ z) = z := by
  rw [ratValue_eq hπ one_ne_zero (z := z) (by simp)]; simp

theorem ratValue_mul {γ δ : Γ} (hγ : IsRationalValue π γ) (hδ : IsRationalValue π δ) :
    ratValue π (γ * δ) = ratValue π γ + ratValue π δ := by
  obtain ⟨n, hn, z, h⟩ := hγ
  obtain ⟨n', hn', z', h'⟩ := hδ
  have hmul : (γ * δ) ^ (n * n') = π ^ (z * n' + z' * n) := by
    rw [mul_pow, pow_mul, h, mul_comm n n', pow_mul, h', zpow_add, zpow_mul, zpow_mul, zpow_natCast,
      zpow_natCast]
  rw [ratValue_eq hπ (Nat.mul_ne_zero hn hn') hmul, ratValue_eq hπ hn h, ratValue_eq hπ hn' h']
  have hnq : (n : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hn
  have hn'q : (n' : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hn'
  push_cast
  field_simp

theorem ratValue_inv {γ : Γ} (hγ : IsRationalValue π γ) : ratValue π γ⁻¹ = -ratValue π γ := by
  obtain ⟨n, hn, z, h⟩ := hγ
  rw [ratValue_eq hπ hn (z := -z) (by rw [inv_pow, h, zpow_neg]), ratValue_eq hπ hn h]
  push_cast
  ring

/-- Rational values are compared as their rational numbers. -/
theorem ratValue_le_iff {γ δ : Γ} (hγ : IsRationalValue π γ) (hδ : IsRationalValue π δ) :
    ratValue π γ ≤ ratValue π δ ↔ γ ≤ δ := by
  obtain ⟨n, hn, z, h⟩ := hγ
  obtain ⟨n', hn', z', h'⟩ := hδ
  rw [ratValue_eq hπ hn h, ratValue_eq hπ hn' h']
  have hnq : (0 : ℚ) < n := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)
  have hn'q : (0 : ℚ) < n' := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn')
  rw [div_le_div_iff₀ hnq hn'q]
  have h1 : γ ^ (n * n') = π ^ (z * n') := by rw [pow_mul, h, zpow_mul, zpow_natCast]
  have h2 : δ ^ (n * n') = π ^ (z' * n) := by
    rw [mul_comm, pow_mul, h', zpow_mul, zpow_natCast]
  have hpow : γ ≤ δ ↔ γ ^ (n * n') ≤ δ ^ (n * n') :=
    (pow_le_pow_iff_left (Nat.mul_ne_zero hn hn')).symm
  rw [hpow, h1, h2, (zpow_right_strictMono hπ).le_iff_le]
  exact_mod_cast Iff.rfl

theorem ratValue_injOn {γ δ : Γ} (hγ : IsRationalValue π γ) (hδ : IsRationalValue π δ)
    (h : ratValue π γ = ratValue π δ) : γ = δ :=
  le_antisymm ((ratValue_le_iff hπ hγ hδ).mp h.le) ((ratValue_le_iff hπ hδ hγ).mp h.ge)

/-- The lattice `m⁻¹ℤ` in terms of rational values. -/
theorem inLattice_iff {m : ℕ} (hm : m ≠ 0) {γ : Γ} (hγ : IsRationalValue π γ) :
    InLattice π m γ ↔ ∃ z : ℤ, (m : ℚ) * ratValue π γ = z := by
  have hmq : (m : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hm
  constructor
  · rintro ⟨z, hz⟩
    exact ⟨z, by rw [ratValue_eq hπ hm hz]; field_simp⟩
  · rintro ⟨z, hz⟩
    have hr : IsRationalValue π (γ ^ m) := by
      obtain ⟨n, hn, y, hy⟩ := hγ
      exact ⟨n, hn, y * m, by rw [← pow_mul, mul_comm, pow_mul, hy, zpow_mul, zpow_natCast]⟩
    refine ⟨z, ratValue_injOn hπ hr ⟨1, one_ne_zero, z, by simp⟩ ?_⟩
    obtain ⟨n, hn, y, hy⟩ := hγ
    have hnq : (n : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hn
    rw [ratValue_zpow hπ, ← hz, ratValue_eq hπ hn hy,
      ratValue_eq hπ hn (z := y * m)
        (by rw [← pow_mul, mul_comm, pow_mul, hy, zpow_mul, zpow_natCast])]
    push_cast
    field_simp

/-- Between two powers of `π` the lattice `m⁻¹ℤ` has finitely many points. -/
theorem finite_lattice_Icc {m : ℕ} (hm : m ≠ 0) (a b : ℤ) :
    {γ : Γ | InLattice π m γ ∧ π ^ a ≤ γ ∧ γ ≤ π ^ b}.Finite := by
  have hsub : {γ : Γ | InLattice π m γ ∧ π ^ a ≤ γ ∧ γ ≤ π ^ b} ⊆
      (fun γ : Γ => γ ^ m) ⁻¹' ((fun z : ℤ => π ^ z) '' Set.Icc (a * m) (b * m)) := by
    rintro γ ⟨⟨z, hz⟩, hα, hβ⟩
    refine ⟨z, ⟨?_, ?_⟩, hz.symm⟩
    · have : π ^ (a * m) ≤ π ^ z := by
        rw [zpow_mul, zpow_natCast, ← hz]; exact pow_le_pow_left' hα m
      exact (zpow_right_strictMono hπ).le_iff_le.mp this
    · have : π ^ z ≤ π ^ (b * m) := by
        rw [zpow_mul, zpow_natCast, ← hz]; exact pow_le_pow_left' hβ m
      exact (zpow_right_strictMono hπ).le_iff_le.mp this
  refine Set.Finite.subset (Set.Finite.preimage ?_ ((Set.finite_Icc _ _).image _)) hsub
  intro x _ y _ hxy
  exact (pow_left_strictMono hm).injective hxy

end

end DiamondIntegral.Section8
