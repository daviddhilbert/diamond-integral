import «section 8».Theorem811RV
import «section 7».Theorem726

/-! Theorem 8.11: `−lim ∘ Z = Θ ∘ 𝔼^◇` on `K(μRV^db[*]) / J_var`, and its composite with `∫^◇`.

* `annular_kills`: `η ∘ (integer part) ∘ h_m` vanishes on all of `J_var` (Lemma 8.3; the
  natural subring is not needed for the integer part), so the zeta function only depends on the
  class modulo `J_var` (`zeta_sub_mem`) and descends to `zetaQ` on `K(μRV^db[*]) / J_var`.
* `theorem_8_11_rv_ring`: for every `x ∈ K(μRV^db[*])`, `Z(x) ∈ R[T]†` and
  `lim_{T → ∞} Z(x) = −Θ(𝔼^◇ x)`. Every element is a `ℤ`-combination of object classes
  (`mem_closure_objectClass`), and both sides are additive.
* `theorem_8_11_quotient`: the same on the quotient, with `𝔼^◇` on `K(μRV^db[*]) / J_var`.
* `theorem_8_11_vf`: for every object `A` of `μVF^◇[*]` over the base,
  `−lim Z(∫^◇[A]) = Θ(𝔼^◇(∫^◇[A]))`, with `∫^◇` the isomorphism of Theorem 7.26.

The identification `Z(∫^◇[𝒳_f]) = Z_f` of Lemma 8.6 and (z:coeff:change), which turns this into
`𝒮_f = Θ 𝔼^◇ ∫^◇ [𝒳_f]`, is not formalized (truncated arcs and jets of varieties). -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace DiamondIntegral.Section8.Hm

open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters
open DiamondIntegral.Section3 DiamondIntegral.Section4 RVMeasuredCharts
open DiamondIntegral.Section8.PuiseuxValues
open DiamondIntegral.Section5 DiamondIntegral.Section5.PuiseuxOriginal
open RationalSeries

variable (P : PuiseuxAmbient)

/-! ### The zeta function descends to `K(μRV^db[*]) / J_var` -/

theorem hmLoc_mem_span (m : ℕ+) {z : RVBoundedRing.Ring (base P)}
    (hz : z ∈ RelativeAnnularGenerators.manuscriptIdeal (base P)) :
    hmLoc P m z ∈ Ideal.span {PuiseuxPolynomial.ofLaurent Rloc (PuiseuxPolynomial.annularElement Lunit)} := by
  have hle : RelativeAnnularGenerators.manuscriptIdeal (base P) ≤
      (Ideal.span {PuiseuxPolynomial.ofLaurent Rloc (PuiseuxPolynomial.annularElement Lunit)}).comap
        (hmLoc P m) := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨k, D, rfl⟩
    exact hmLoc_generator_mem P D m
  exact hle hz

/-- **`η ∘ h_m` (integer part) vanishes on `J_var`.** -/
theorem annular_kills {z : RVBoundedRing.Ring (base P)}
    (hz : z ∈ RelativeAnnularGenerators.manuscriptIdeal (base P)) : zeta P z = 0 := by
  ext n
  simp only [zeta, zetaCoeff, PowerSeries.coeff_mk, map_zero]
  split_ifs with hn
  · rfl
  · exact PuiseuxPolynomial.eta_integerPart_of_mem_span Lunit (hmLoc_mem_span P _ hz)

theorem zeta_sub (x y : RVBoundedRing.Ring (base P)) : zeta P (x - y) = zeta P x - zeta P y := by
  rw [sub_eq_add_neg, zeta_add, zeta_neg, ← sub_eq_add_neg]

theorem zeta_sub_mem {x y : RVBoundedRing.Ring (base P)}
    (h : x - y ∈ RelativeAnnularGenerators.manuscriptIdeal (base P)) : zeta P x = zeta P y := by
  have := annular_kills P h
  rwa [zeta_sub, sub_eq_zero] at this

/-- The zeta function on `K(μRV^db[*]) / J_var`. -/
def zetaQ (q : RelativeAnnularQuotient.Ring (base P)) : PowerSeries Rloc :=
  zeta P (Ideal.Quotient.mk_surjective q).choose

theorem zetaQ_quotient (x : RVBoundedRing.Ring (base P)) :
    zetaQ P (RelativeAnnularQuotient.quotient (base P) x) = zeta P x := by
  have hs := (Ideal.Quotient.mk_surjective (RelativeAnnularQuotient.quotient (base P) x)).choose_spec
  refine zeta_sub_mem P ?_
  rw [← RelativeAnnularConverse.ideal_eq_manuscriptIdeal]
  exact Ideal.Quotient.eq.mp hs

/-- `𝔼^◇` on `K(μRV^db[*]) / J_var`. -/
def EdiamondQ : RelativeAnnularQuotient.Ring (base P) →+* RESDimensionFreeReduction.Ring (base P) :=
  (RESDimensionFreeReduction.fromGradedReduced (base P)).comp
    (RelativeAnnularQuotient.evaluation P.hc P.G.model00 Section5.GammaQE.gamma_piecewise_rational_affine
      P.G.uncountable.le P.G.saturated (base P) P.G.small_real (hγ0 P) (base_nontrivial P)
      EulerKind.geometric)

theorem Ediamond_eq (x : RVBoundedRing.Ring (base P)) :
    Ediamond P x = EdiamondQ P (RelativeAnnularQuotient.quotient (base P) x) := rfl

/-! ### Every element is a combination of object classes -/

/-- The additive subgroup generated by the object classes. -/
def objSpan : AddSubgroup (RVBoundedRing.Ring (base P)) :=
  AddSubgroup.closure {y | ∃ k, ∃ a : RVBoundedCharts.BoundedChart (base P) k, y = RVBoundedRing.objectClass a}

theorem objSpan_mul {x y : RVBoundedRing.Ring (base P)} (hx : x ∈ objSpan P) (hy : y ∈ objSpan P) :
    x * y ∈ objSpan P := by
  induction hx using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨k, a, rfl⟩ := hx
    induction hy using AddSubgroup.closure_induction with
    | mem y hy =>
      obtain ⟨l, b, rfl⟩ := hy
      rw [← RVBoundedRing.objectClass_product]
      exact AddSubgroup.subset_closure ⟨_, _, rfl⟩
    | zero => rw [mul_zero]; exact zero_mem _
    | add y z _ _ hy hz => rw [mul_add]; exact add_mem hy hz
    | neg y _ hy => rw [mul_neg]; exact neg_mem hy
  | zero => rw [zero_mul]; exact zero_mem _
  | add x z _ _ hx hz => rw [add_mul]; exact add_mem hx hz
  | neg x _ hx => rw [neg_mul]; exact neg_mem hx

theorem mem_closure_objectClass (x : RVBoundedRing.Ring (base P)) : x ∈ objSpan P := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  refine FreeCommRing.induction_on r ?_ ?_ ?_ ?_
  · rw [map_neg, map_one, ← RVBoundedRing.objectClass_unit]
    exact neg_mem (AddSubgroup.subset_closure ⟨_, _, rfl⟩)
  · intro g
    exact AddSubgroup.subset_closure ⟨g.1, g.2, rfl⟩
  · intro r s hr hs
    rw [map_add]
    exact add_mem hr hs
  · intro r s hr hs
    rw [map_mul]
    exact objSpan_mul P hr hs

/-! ### Theorem 8.11 -/

/-- **Theorem 8.11 on the RV side, for every element.** For every `x ∈ K(μRV^db[*])`, the zeta
function `Z(x)(T) = Σ_{m ≥ 1} η(h_m x) T^m` lies in `K^μ̂ Var_ℂ[[𝔸]⁻¹][T]†`, has degree `≤ 0`, and
`lim_{T → ∞} Z(x)(T) = −Θ(𝔼^◇ x)`. -/
theorem theorem_8_11_rv_ring (x : RVBoundedRing.Ring (base P)) :
    HasLimit Lunit (zeta P x) (-(algebraMap EquivariantVariety.ModifiedRing Rloc (theta P (Ediamond P x)))) := by
  induction mem_closure_objectClass P x using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨k, a, rfl⟩ := hx
    exact theorem_8_11_rv P a
  | zero => simpa [zeta_zero] using hasLimit_zero Lunit
  | add x y _ _ hx hy =>
    rw [zeta_add, map_add, map_add, map_add, neg_add]
    exact hx.add Lunit hy
  | neg x _ hx =>
    have h := HasLimit.const_mul hx (-1)
    rw [zeta_neg, map_neg, map_neg, map_neg]
    convert h using 1
    · rw [map_neg, map_one, neg_one_mul]
    · ring

/-- **Theorem 8.11 on `K(μRV^db[*]) / J_var`.** `−lim ∘ Z = Θ ∘ 𝔼^◇`. -/
theorem theorem_8_11_quotient (q : RelativeAnnularQuotient.Ring (base P)) :
    HasLimit Lunit (zetaQ P q) (-(algebraMap EquivariantVariety.ModifiedRing Rloc (theta P (EdiamondQ P q)))) := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
  have h := theorem_8_11_rv_ring P x
  rw [Ediamond_eq] at h
  change HasLimit Lunit (zetaQ P (RelativeAnnularQuotient.quotient (base P) x)) _
  rw [zetaQ_quotient]
  exact h

section VF

open SpecialTransformations.Section9 SpecialTransformations.Section4 SpecialTransformations.DefinableGeometry
open DiamondIntegral.Section7.Theorem726 DiamondIntegral.Section6 DiamondIntegral.Section2
open DiamondIntegral.Section6.DiamondCategory DiamondIntegral.Section7.DiamondRing

variable (Gv : Type) [LinearOrderedCommGroupWithZero Gv] [Valued (VF P.N) Gv]
variable (hv : ∀ x y : VF P.N, VFValued.predV x y ↔ Valued.v x ≤ Valued.v y)
variable (hntB : ∃ x : P.G.fieldBase.field, x ≠ 0 ∧ Valued.v x.val ≠ 1)

/-- **Theorem 8.11 composed with `∫^◇` (Theorem 7.26).** For every object `A` of `μVF^◇[*]` over
the base of Section 8, the zeta function of `∫^◇[A]` lies in `R[T]†` and
`−lim_{T → ∞} Z(∫^◇[A]) = Θ(𝔼^◇(∫^◇[A]))`. -/
theorem theorem_8_11_vf {k : ℕ} (A : DiamondCategory.VFObject (M := P.N) (P.G.real : Set P.N) k) :
    HasLimit Lunit
      (zetaQ P (theorem_7_26_graded Gv P.G.model00 P.hc P.G.uncountable P.G.saturated hv P.G.real
        P.G.small_real (base_nontrivial P) P.G.fieldBase hntB
        (ringClass Gv P.hc (unitObj Gv P.G.model00 P.hc P.G.uncountable P.G.saturated hv
          P.G.real P.G.small_real (base_nontrivial P)) A)))
      (-(algebraMap EquivariantVariety.ModifiedRing Rloc (theta P (EdiamondQ P
        (theorem_7_26_graded Gv P.G.model00 P.hc P.G.uncountable P.G.saturated hv P.G.real
          P.G.small_real (base_nontrivial P) P.G.fieldBase hntB
          (ringClass Gv P.hc (unitObj Gv P.G.model00 P.hc P.G.uncountable P.G.saturated hv
            P.G.real P.G.small_real (base_nontrivial P)) A)))))) :=
  theorem_8_11_quotient P _

end VF

end DiamondIntegral.Section8.Hm
