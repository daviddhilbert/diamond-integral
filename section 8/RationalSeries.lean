import Mathlib.RingTheory.PowerSeries.Basic
import Mathlib.Algebra.Polynomial.Degree.Operations
import Mathlib.Algebra.Polynomial.Degree.Lemmas
import Mathlib.Tactic.Ring
import Mathlib.Tactic.LinearCombination

/-! Rational series with a limit at infinity (Hrushovski–Loeser, §8.4).

For a commutative ring `R` and a unit `A`, the ring `R[T]†` is the localization
of `R[T]` at the polynomials `1 − A^a T^b`, `a ∈ ℤ`, `b ≥ 1`, viewed inside
`R⟦T⟧`. An element `h = P/Q` has `deg h = deg P − deg Q`, and for `deg h ≤ 0`
its limit at infinity is the quotient of the coefficients of `T^(deg Q)`.

We do not build the localization. `HasLimit A φ c` says that the power series
`φ` is of the form `P/Q` with `Q` a product of polynomials `1 − A^a T^b`,
`deg P ≤ deg Q`, and limit `c`. The limit is unique and additive.

This file uses Mathlib only. -/

set_option autoImplicit false

open Polynomial

namespace DiamondIntegral.Section8.RationalSeries

variable {R : Type*} [CommRing R] (A : Rˣ)

/-- The polynomial `1 − A^a T^b`. -/
noncomputable def daggerFactor (a : ℤ) (b : ℕ) : R[X] := 1 - C ((A ^ a : Rˣ) : R) * X ^ b

/-- The multiplicative set generated by the `1 − A^a T^b` with `b ≥ 1`. -/
noncomputable def daggerDenominators : Submonoid R[X] :=
  Submonoid.closure {q | ∃ (a : ℤ) (b : ℕ), 0 < b ∧ q = daggerFactor A a b}

theorem daggerFactor_mem (a : ℤ) {b : ℕ} (hb : 0 < b) : daggerFactor A a b ∈ daggerDenominators A :=
  Submonoid.subset_closure ⟨a, b, hb, rfl⟩

theorem natDegree_daggerFactor [Nontrivial R] (a : ℤ) {b : ℕ} (hb : 0 < b) :
    (daggerFactor A a b).natDegree = b := by
  have hu : ((A ^ a : Rˣ) : R) ≠ 0 := (A ^ a).ne_zero
  have hd : (C ((A ^ a : Rˣ) : R) * X ^ b).natDegree = b := natDegree_C_mul_X_pow b _ hu
  unfold daggerFactor
  rw [natDegree_sub_eq_right_of_natDegree_lt (by rw [natDegree_one, hd]; exact hb), hd]

theorem leadingCoeff_daggerFactor [Nontrivial R] (a : ℤ) {b : ℕ} (hb : 0 < b) :
    (daggerFactor A a b).leadingCoeff = -((A ^ a : Rˣ) : R) := by
  rw [leadingCoeff, natDegree_daggerFactor A a hb]
  unfold daggerFactor
  rw [coeff_sub, coeff_C_mul_X_pow, coeff_one]
  simp [hb.ne']

/-- Every denominator has an invertible leading coefficient. -/
theorem isUnit_leadingCoeff {Q : R[X]} (hQ : Q ∈ daggerDenominators A) : IsUnit Q.leadingCoeff := by
  rcases subsingleton_or_nontrivial R with h | h
  · exact isUnit_of_subsingleton _
  induction hQ using Submonoid.closure_induction with
  | mem q hq =>
    obtain ⟨a, b, hb, rfl⟩ := hq
    rw [leadingCoeff_daggerFactor A a hb]
    exact (A ^ a).isUnit.neg
  | one => rw [leadingCoeff_one]; exact isUnit_one
  | mul p q _ _ hp hq =>
    rw [leadingCoeff_mul' (hp.mul hq).ne_zero]
    exact hp.mul hq

theorem natDegree_mul_of_mem [Nontrivial R] {P Q : R[X]} (hP : P ∈ daggerDenominators A)
    (hQ : Q ∈ daggerDenominators A) : (P * Q).natDegree = P.natDegree + Q.natDegree :=
  natDegree_mul' ((isUnit_leadingCoeff A hP).mul (isUnit_leadingCoeff A hQ)).ne_zero

theorem leadingCoeff_mul_of_mem [Nontrivial R] {P Q : R[X]} (hP : P ∈ daggerDenominators A)
    (hQ : Q ∈ daggerDenominators A) : (P * Q).leadingCoeff = P.leadingCoeff * Q.leadingCoeff :=
  leadingCoeff_mul' ((isUnit_leadingCoeff A hP).mul (isUnit_leadingCoeff A hQ)).ne_zero

/-- `φ` lies in `R[T]†`, has degree `≤ 0`, and its limit at infinity is `c`. -/
def HasLimit (φ : PowerSeries R) (c : R) : Prop :=
  ∃ P Q : R[X], Q ∈ daggerDenominators A ∧ (Q : PowerSeries R) * φ = (P : PowerSeries R) ∧
    P.natDegree ≤ Q.natDegree ∧ P.coeff Q.natDegree = c * Q.leadingCoeff

/-- `φ` lies in `R[T]†`. -/
def IsDagger (φ : PowerSeries R) : Prop :=
  ∃ P Q : R[X], Q ∈ daggerDenominators A ∧ (Q : PowerSeries R) * φ = (P : PowerSeries R)

theorem HasLimit.isDagger {φ : PowerSeries R} {c : R} (h : HasLimit A φ c) : IsDagger A φ := by
  obtain ⟨P, Q, hQ, he, -, -⟩ := h
  exact ⟨P, Q, hQ, he⟩

theorem hasLimit_of_subsingleton [Subsingleton R] (φ : PowerSeries R) (c : R) : HasLimit A φ c :=
  ⟨0, 1, one_mem _, Subsingleton.elim _ _, by simp, Subsingleton.elim _ _⟩

theorem hasLimit_zero : HasLimit A (0 : PowerSeries R) 0 :=
  ⟨0, 1, one_mem _, by simp, by simp, by simp⟩

/-- The limit is unique. -/
theorem HasLimit.unique {φ : PowerSeries R} {c c' : R} (h : HasLimit A φ c) (h' : HasLimit A φ c') :
    c = c' := by
  obtain ⟨P, Q, hQ, he, hd, hc⟩ := h
  obtain ⟨P', Q', hQ', he', hd', hc'⟩ := h'
  have hpoly : P * Q' = P' * Q := by
    apply Polynomial.coe_injective
    rw [Polynomial.coe_mul, Polynomial.coe_mul, ← he, ← he']
    ring
  have h1 : (P * Q').coeff (Q.natDegree + Q'.natDegree) = c * Q.leadingCoeff * Q'.leadingCoeff := by
    rw [coeff_mul_add_eq_of_natDegree_le hd le_rfl, hc, coeff_natDegree]
  have h2 : (P' * Q).coeff (Q'.natDegree + Q.natDegree) = c' * Q'.leadingCoeff * Q.leadingCoeff := by
    rw [coeff_mul_add_eq_of_natDegree_le hd' le_rfl, hc', coeff_natDegree]
  rw [hpoly, add_comm, h2] at h1
  have hu := (isUnit_leadingCoeff A hQ).mul (isUnit_leadingCoeff A hQ')
  apply hu.mul_left_injective
  simp only
  linear_combination -h1

/-- Limits add. -/
theorem HasLimit.add {φ ψ : PowerSeries R} {c d : R} (h : HasLimit A φ c) (h' : HasLimit A ψ d) :
    HasLimit A (φ + ψ) (c + d) := by
  rcases subsingleton_or_nontrivial R with hR | hR
  · exact ⟨0, 1, one_mem _, Subsingleton.elim _ _, by simp, Subsingleton.elim _ _⟩
  obtain ⟨P, Q, hQ, he, hd, hc⟩ := h
  obtain ⟨P', Q', hQ', he', hd', hc'⟩ := h'
  have hdeg : (Q * Q').natDegree = Q.natDegree + Q'.natDegree := natDegree_mul_of_mem A hQ hQ'
  refine ⟨P * Q' + P' * Q, Q * Q', mul_mem hQ hQ', ?_, ?_, ?_⟩
  · rw [Polynomial.coe_add, Polynomial.coe_mul, Polynomial.coe_mul, Polynomial.coe_mul, ← he, ← he']
    ring
  · rw [hdeg]
    refine (natDegree_add_le _ _).trans (max_le ?_ ?_)
    · exact natDegree_mul_le.trans (Nat.add_le_add_right hd _)
    · exact natDegree_mul_le.trans (by omega)
  · rw [hdeg, coeff_add, coeff_mul_add_eq_of_natDegree_le hd le_rfl, add_comm Q.natDegree,
      coeff_mul_add_eq_of_natDegree_le hd' le_rfl, hc, hc', coeff_natDegree, coeff_natDegree,
      leadingCoeff_mul_of_mem A hQ hQ']
    ring

/-- Limits of finite sums. -/
theorem HasLimit.sum {ι : Type*} (s : Finset ι) (φ : ι → PowerSeries R) (c : ι → R)
    (h : ∀ i ∈ s, HasLimit A (φ i) (c i)) : HasLimit A (∑ i ∈ s, φ i) (∑ i ∈ s, c i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using hasLimit_zero A
  | insert i s hi ih =>
    rw [Finset.sum_insert hi, Finset.sum_insert hi]
    exact (h i (Finset.mem_insert_self i s)).add A
      (ih fun j hj => h j (Finset.mem_insert_of_mem hj))

/-- A fraction `P/Q` with `deg P ≤ deg Q` has the expected limit. -/
theorem hasLimit_of_fraction {φ : PowerSeries R} {P Q : R[X]} (hQ : Q ∈ daggerDenominators A)
    (he : (Q : PowerSeries R) * φ = (P : PowerSeries R)) (hd : P.natDegree ≤ Q.natDegree) {c : R}
    (hc : P.coeff Q.natDegree = c * Q.leadingCoeff) : HasLimit A φ c :=
  ⟨P, Q, hQ, he, hd, hc⟩

end DiamondIntegral.Section8.RationalSeries
