import «section 7».MeasuredLift
import «section 7».KernelDimOne
import «section 7».SetBaseMatching
import «section 2».ParameterCores
import Section4.SmallGeneratedBase

/-! Lemma 7.13 over a base with adjoined VF parameters.

Corollary 7.15 applies Lemma 7.13 over `S⟨b⟩` for a VF tuple `b`. Section 6's
Lemma 6.38 asks for a substructure with a VF field base. A substructure
generated by `T ∪ b` need not have one: the residue addition is only
constrained at units, so the generated RV part need not consist of leading
terms of field elements. The proof of 6.38, however, only uses support data
`V ⊆ S ⊆ acl(V)` (`SetBaseMatching`). So:

* `lift_iso_muIsp_of_support`, `lemma_7_13_of_support`: Lemma 7.13 over a
  substructure `T` with support data, through `lemma_7_11_measured` (no
  Lemma 6.33 is needed);
* `adjoin T b`: the substructure generated by `T` and the coordinates of `b`.
  It is small, its Γ is nontrivial, and it has support data
  (`adjoin_support`, from Section 2's `parameter_core`). -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 4000000
noncomputable section
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3
open SpecialTransformations.Section4 SpecialTransformations.DefinableGeometry

namespace DiamondIntegral.Section7.KernelBaseChange
open DiamondIntegral.Section6 DiamondIntegral.Section2
open DiamondIntegral.Section6.DiamondCategory DiamondIntegral.Section6.DiamondGroupoid
open DiamondIntegral.Section6.DiamondLift DiamondIntegral.Section6.DiamondStandardContraction
open DiamondIntegral.Section7.SpecialChains DiamondIntegral.Section7.KernelDimOne
open DiamondIntegral.Section7.BlowupCongruence DiamondIntegral.Section7.ElementaryBlowups
open DiamondIntegral.Section7.ChartOfMeasured DiamondIntegral.Section7.LiftClasses
open DiamondIntegral.Section7.BoundedClasses DiamondIntegral.Section7.MeasuredLift
open DiamondIntegral.Section7.SetBaseMatching

variable {M : Type} [LRV.Structure M] [hM : M ⊨ Axioms.ACVF]
variable {G : Type} [LinearOrderedCommGroupWithZero G] [Valued (VF M) G]
variable (hc : CanonicalStructure.IsCanonical (M := M)) {T : LRV.Substructure M}

/-! ### Lemma 7.13 over a base with support data -/

section Kernel
variable (h00 : M ⊨ Axioms.ACVF00) {κ : Cardinal} (hκ : Cardinal.aleph0 < κ) (hs : Saturated M κ)
variable (hv : ∀ x y : VF M, VFValued.predV x y ↔ Valued.v x ≤ Valued.v y)
variable (W : Set M) (hW : ∀ x ∈ W, iVF x) (hWT : W ⊆ (T : Set M))
  (hTW : (T : Set M) ⊆ algebraicClosureSet W)
  (hnt : ∃ x : vfAlgebraicClosureField W, x ≠ 0 ∧ Valued.v x.val ≠ 1)
variable (hsmall : Cardinal.mk (T : Set M) < κ)
variable (hΓ : NontrivialDefinableGamma (⟨(T : Set M), ∅⟩ : ParameterBase M))

include h00 hκ hs hv hW hWT hTW hnt hsmall hΓ in
/-- Lemma 7.13, core form, over a substructure with support data: isomorphic
lifts of doubly bounded objects of `μRV^db[1]` give `μIsp^db`-related
classes. -/
theorem lift_iso_muIsp_of_support {U U' : MeasuredRVObject (M := M) (T : Set M) 1} (hU : U.doublyBounded)
    (hU' : U'.doublyBounded) (hPU : ProperInvariant (T : Set M) (rvLift U.object).carrier)
    (hPU' : ProperInvariant (T : Set M) (rvLift U'.object).carrier)
    (F : Isomorphic G (liftObject U hPU) (liftObject U' hPU')) :
    MuIsp (k := 0) (cls (objOf hc T U hU)) (cls (objOf hc T U' hU')) := by
  obtain ⟨Φ⟩ := F
  obtain ⟨H, chA, chB, -, -, hA', hB', -, -, -, -, e, -⟩ :=
    lemma_6_38_diamond_contractible_of_support h00 hc lin hκ hs hv (T : Set M) W hW hWT hTW hnt hsmall hΓ Φ
  obtain ⟨gA, hfA, m, hm⟩ := lemma_7_11_measured (k := 0) hc U hU hκ hs hsmall h00 chA
  obtain ⟨gB, hfB, n, hn⟩ := lemma_7_11_measured (k := 0) hc U' hU' hκ hs hsmall h00 chB
  have eA := clsG_source hc H gA hfA hA'
  have eB := clsG_target hc H gB hfB hB'
  have eAB := cls_objOf_eq hc (H.sourceRV_doublyBounded hA') (H.targetRV_doublyBounded hB') e
  refine ⟨clsG hc gA, m, n, hm, ?_⟩
  rw [eA, eAB, ← eB]
  exact hn

include h00 hκ hs hv hW hWT hTW hnt hsmall hΓ in
/-- Lemma 7.13 (`kernel:dim:1:coa`) over a substructure with support data: if
`A ≅ B` in `μVF^◇[1]` and `U`, `V` are standard contractions of `A`, `B`, then
`([U], [V]) ∈ μIsp^db`. -/
theorem lemma_7_13_of_support {A B : VFObject (M := M) (T : Set M) 1} (F : Isomorphic G A B)
    {e₁ e₂ : Equiv.Perm (Fin 1)} (FA : NormalizedMeasuredContraction (G := G) A.carrier A.form e₁)
    (FB : NormalizedMeasuredContraction (G := G) B.carrier B.form e₂) :
    MuIsp (k := 0)
      (cls (objOf hc T (FA.headStartMeasuredObject h00 hc lin hκ hs hv hsmall hΓ 0 Fin.elim0
        (object_hFin A Fin.elim0)) (FA.headStartObject_doublyBounded 0 Fin.elim0)))
      (cls (objOf hc T (FB.headStartMeasuredObject h00 hc lin hκ hs hv hsmall hΓ 0 Fin.elim0
        (object_hFin B Fin.elim0)) (FB.headStartObject_doublyBounded 0 Fin.elim0))) := by
  have hE := isomorphic_equivalence (G := G) (S := (T : Set M)) (n := 1) h00 hc hκ.le hs hsmall hv
  obtain ⟨hPU, iA⟩ := remark_6_28 h00 hc lin hκ hs hv hsmall hΓ A FA 0 Fin.elim0
  obtain ⟨hPV, iB⟩ := remark_6_28 h00 hc lin hκ hs hv hsmall hΓ B FB 0 Fin.elim0
  have iA' : Isomorphic G A (liftObject _ hPU) := iA
  have iB' : Isomorphic G B (liftObject _ hPV) := iB
  exact lift_iso_muIsp_of_support hc h00 hκ hs hv W hW hWT hTW hnt hsmall hΓ _ _ hPU hPV
    (hE.trans (hE.symm iA') (hE.trans F iB'))

end Kernel

/-! ### Adjoining VF parameters -/

section Adjoin
variable {m : ℕ}

/-- The substructure generated by `T` and the coordinates of `b`. -/
def adjoin (T : LRV.Substructure M) (b : Fin m → VF M) : LRV.Substructure M :=
  Substructure.closure LRV ((T : Set M) ∪ Set.range (vfValues b))

theorem subset_adjoin (b : Fin m → VF M) : (T : Set M) ⊆ adjoin T b :=
  fun _ hx => Substructure.subset_closure (Or.inl hx)

theorem coordinate_mem_adjoin (b : Fin m → VF M) (i : Fin m) : (b i).val ∈ adjoin T b :=
  Substructure.subset_closure (Or.inr ⟨i, rfl⟩)

theorem adjoin_small {κ : Cardinal} (hκ : Cardinal.aleph0 < κ) (hsmall : Cardinal.mk (T : Set M) < κ)
    (b : Fin m → VF M) : Cardinal.mk (adjoin T b : Set M) < κ :=
  small_generated_substructure hκ _ (small_union_range hκ.le _ hsmall _)

theorem adjoin_gamma (hΓ : NontrivialDefinableGamma (⟨(T : Set M), ∅⟩ : ParameterBase M))
    (b : Fin m → VF M) : NontrivialDefinableGamma (⟨(adjoin T b : Set M), ∅⟩ : ParameterBase M) :=
  hΓ.mono (subset_adjoin b) (Set.Subset.refl _)

include hc in
/-- Support data for the adjoined base: the VF names of the field base of `T`
and the coordinates of `b`. -/
theorem adjoin_support (B₀ : VFGeneratedFieldBase T) (hnt : ∃ x : B₀.field, x ≠ 0 ∧ Valued.v x.val ≠ 1)
    (b : Fin m → VF M) :
    (∀ x ∈ vfFieldNames B₀.field ∪ Set.range (vfValues b), iVF x) ∧
      vfFieldNames B₀.field ∪ Set.range (vfValues b) ⊆ (adjoin T b : Set M) ∧
      (adjoin T b : Set M) ⊆ algebraicClosureSet (vfFieldNames B₀.field ∪ Set.range (vfValues b)) ∧
      ∃ x : vfAlgebraicClosureField (vfFieldNames B₀.field ∪ Set.range (vfValues b)),
        x ≠ 0 ∧ Valued.v x.val ≠ 1 := by
  obtain ⟨hV, hVT, hTV, hnt'⟩ := VFGeneratedFieldBase.parameter_core Valued.v T B₀ hnt b
  refine ⟨hV, hVT.trans (fun _ hx => Substructure.subset_closure hx), ?_, hnt'⟩
  intro x hx
  have hle : adjoin T b ≤ algebraicClosureSubstructure hc
      (vfFieldNames B₀.field ∪ Set.range (vfValues b)) :=
    (Substructure.closure_le (L := LRV)).mpr hTV
  exact hle hx

end Adjoin

end DiamondIntegral.Section7.KernelBaseChange
