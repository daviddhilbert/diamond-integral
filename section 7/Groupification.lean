import HilbertMathlib.Foundation.Grothendieck.GrothendieckRing
import Mathlib.GroupTheory.Congruence.Hom
import Mathlib.GroupTheory.QuotientGroup.Defs
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-! The Grothendieck group of a quotient monoid (used in Theorem 7.26).

For a commutative monoid `M` and an additive congruence `c` on `M`, the
Grothendieck group of `M ⧸ c` is the quotient of the Grothendieck group of `M`
by the subgroup generated by the differences `x − y` with `c x y`
(`groupQuotientEquiv`). No cancellation in `M` is assumed. The statement is
general and self-contained. -/

noncomputable section

namespace DiamondIntegral.Section7.Groupification

open Algebra

variable {M : Type*} [AddCommMonoid M] (c : AddCon M)

/-- The subgroup of `K(M)` generated by the differences `[x] − [y]` with
`c x y`. -/
def relationSubgroup : AddSubgroup (GrothendieckAddGroup M) :=
  AddSubgroup.closure {z | ∃ x y, c x y ∧ z = GrothendieckAddGroup.of x - GrothendieckAddGroup.of y}

theorem sub_mem_relationSubgroup {x y : M} (h : c x y) :
    GrothendieckAddGroup.of x - GrothendieckAddGroup.of y ∈ relationSubgroup c :=
  AddSubgroup.subset_closure ⟨x, y, h, rfl⟩

/-- The map `K(M) → K(M ⧸ c)` induced by the quotient map. -/
def toQuotientGroup : GrothendieckAddGroup M →+ GrothendieckAddGroup c.Quotient :=
  GrothendieckAddGroup.lift ((GrothendieckAddGroup.of).comp c.mk')

@[simp] theorem toQuotientGroup_of (x : M) :
    toQuotientGroup c (GrothendieckAddGroup.of x) = GrothendieckAddGroup.of (c.mk' x) := by
  rw [toQuotientGroup, GrothendieckAddGroup.lift_apply_of]
  rfl

theorem relationSubgroup_le_ker : relationSubgroup c ≤ (toQuotientGroup c).ker := by
  refine (AddSubgroup.closure_le _).mpr ?_
  rintro _ ⟨x, y, h, rfl⟩
  change toQuotientGroup c _ = 0
  rw [map_sub, toQuotientGroup_of, toQuotientGroup_of]
  have he : c.mk' x = c.mk' y := (AddCon.eq c).mpr h
  rw [he, sub_self]

/-- `K(M) ⧸ ⟨[x] − [y] : c x y⟩ → K(M ⧸ c)`. -/
def descend : GrothendieckAddGroup M ⧸ relationSubgroup c →+ GrothendieckAddGroup c.Quotient :=
  QuotientAddGroup.lift (relationSubgroup c) (toQuotientGroup c) (relationSubgroup_le_ker c)

/-- The monoid map `M ⧸ c → K(M) ⧸ ⟨[x] − [y] : c x y⟩`. -/
def ofQuotient : c.Quotient →+ GrothendieckAddGroup M ⧸ relationSubgroup c :=
  c.lift ((QuotientAddGroup.mk' (relationSubgroup c)).comp GrothendieckAddGroup.of) (by
    intro x y h
    change QuotientAddGroup.mk' _ (GrothendieckAddGroup.of x) = QuotientAddGroup.mk' _ (GrothendieckAddGroup.of y)
    rw [QuotientAddGroup.mk'_eq_mk']
    refine ⟨-(GrothendieckAddGroup.of x - GrothendieckAddGroup.of y),
      (relationSubgroup c).neg_mem (sub_mem_relationSubgroup c h), ?_⟩
    rw [neg_sub, add_sub_cancel])

/-- `K(M ⧸ c) → K(M) ⧸ ⟨[x] − [y] : c x y⟩`. -/
def ascend : GrothendieckAddGroup c.Quotient →+ GrothendieckAddGroup M ⧸ relationSubgroup c :=
  GrothendieckAddGroup.lift (ofQuotient c)

theorem ascend_of_mk (x : M) :
    ascend c (GrothendieckAddGroup.of (c.mk' x)) =
      QuotientAddGroup.mk' (relationSubgroup c) (GrothendieckAddGroup.of x) := by
  rw [ascend, GrothendieckAddGroup.lift_apply_of]
  rfl

theorem descend_mk (z : GrothendieckAddGroup M) :
    descend c (QuotientAddGroup.mk' (relationSubgroup c) z) = toQuotientGroup c z := rfl

theorem ascend_descend : (ascend c).comp (descend c) = AddMonoidHom.id _ := by
  apply QuotientAddGroup.addMonoidHom_ext
  apply GrothendieckAddGroup.addHom_ext
  intro x
  change ascend c (toQuotientGroup c (GrothendieckAddGroup.of x)) = _
  rw [toQuotientGroup_of, ascend_of_mk]
  rfl

theorem descend_ascend : (descend c).comp (ascend c) = AddMonoidHom.id _ := by
  apply GrothendieckAddGroup.addHom_ext
  intro q
  obtain ⟨x, hx⟩ := AddCon.mk'_surjective (c := c) q
  rw [← hx]
  change descend c (ascend c (GrothendieckAddGroup.of (c.mk' x))) = _
  rw [ascend_of_mk, descend_mk, toQuotientGroup_of]
  rfl

/-- The Grothendieck group of `M ⧸ c` is `K(M)` modulo the differences of
related elements. -/
def groupQuotientEquiv : GrothendieckAddGroup c.Quotient ≃+ GrothendieckAddGroup M ⧸ relationSubgroup c where
  toFun := ascend c
  invFun := descend c
  left_inv z := congrArg (fun f => f z) (descend_ascend c)
  right_inv z := congrArg (fun f => f z) (ascend_descend c)
  map_add' := map_add _

theorem groupQuotientEquiv_of (x : M) :
    groupQuotientEquiv c (GrothendieckAddGroup.of (c.mk' x)) =
      QuotientAddGroup.mk' (relationSubgroup c) (GrothendieckAddGroup.of x) :=
  ascend_of_mk c x

end DiamondIntegral.Section7.Groupification
