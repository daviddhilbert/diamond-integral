import «section 3».ACFDefinableClosure
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
set_option backward.isDefEq.respectTransparency false
set_option autoImplicit false
open Classical FirstOrder FirstOrder.Language FirstOrder.Ring
noncomputable section
namespace DiamondIntegral.Section3
variable {K : Type} [Field K] [IsAlgClosed K] [CharZero K] [CompatibleRing K] {n : ℕ}

/-- The unique output of a field-definable relation lies in the field
generated by its actual inputs, with no algebraic extension of parameters. -/
theorem acf_definable_graph_value_mem_adjoin (E : Subfield K)
    (R : Set (Fin n ⊕ Fin 1 → K)) (hR : (E : Set K).Definable Language.ring R)
    (x : Fin n → K) (y : K) (hxy : Sum.elim x (fun _ => y) ∈ R)
    (hu : ∀ z : K, Sum.elim x (fun _ => z) ∈ R → z = y) :
    y ∈ IntermediateField.adjoin E (Set.range x) := by
  let F := IntermediateField.adjoin E (Set.range x)
  have hEF : (E : Set K) ⊆ (F.toSubfield : Set K) := by
    intro c hc
    exact F.algebraMap_mem (⟨c,hc⟩ : E)
  have hR' := hR.mono hEF
  let g : (Fin 1 → K) → (Fin n ⊕ Fin 1 → K) := fun z => Sum.elim x z
  have hg : (F.toSubfield : Set K).DefinableMap Language.ring g := by
    intro i
    cases i with
    | inl i =>
      exact Language.definableFun_const (M := K) Language.ring (Fin 1)
        (IntermediateField.subset_adjoin E _ (Set.mem_range_self i))
    | inr i => exact Set.DefinableFun.proj Language.ring
  have hp := hR'.preimage_map hg
  have he : g ⁻¹' R = {z : Fin 1 → K | z 0 = y} := by
    ext z
    have hz : z = fun _ : Fin 1 => z 0 := funext fun i => congrArg z (Subsingleton.elim i 0)
    change Sum.elim x z ∈ R ↔ z 0 = y
    constructor
    · intro h
      exact hu (z 0) (Eq.mp (congrArg (fun t : Fin 1 → K => Sum.elim x t ∈ R) hz) h)
    · intro h
      have heq : z = fun _ : Fin 1 => y := by
        funext i
        exact (congrArg z (Subsingleton.elim i 0)).trans h
      rw [heq]
      exact hxy
  have hs : (F.toSubfield : Set K).Definable Language.ring {z : Fin 1 → K | z 0 = y} := he ▸ hp
  exact acf_definable_singleton_mem_subfield F.toSubfield y hs

/-- Every such output is the value of a fraction of polynomials over
the original field, with a genuinely nonzero denominator at the input. -/
theorem acf_definable_graph_value_rational (E : Subfield K)
    (R : Set (Fin n ⊕ Fin 1 → K)) (hR : (E : Set K).Definable Language.ring R)
    (x : Fin n → K) (y : K) (hxy : Sum.elim x (fun _ => y) ∈ R)
    (hu : ∀ z : K, Sum.elim x (fun _ => z) ∈ R → z = y) :
    ∃ p q : MvPolynomial (Fin n) E, MvPolynomial.aeval x q ≠ 0 ∧
      y = MvPolynomial.aeval x p / MvPolynomial.aeval x q := by
  by_cases hy : y = 0
  · exact ⟨0,1,by simp,by simp [hy]⟩
  obtain ⟨p,q,hpq⟩ := (IntermediateField.mem_adjoin_range_iff E x y).mp
    (acf_definable_graph_value_mem_adjoin E R hR x y hxy hu)
  refine ⟨p,q,?_,hpq⟩
  intro hq
  exact hy (by rw [hpq,hq,div_zero])

end DiamondIntegral.Section3
