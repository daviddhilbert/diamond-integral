import «section 2».AlgebraicChoice
import «section 3».GammaHyperplaneCoordinates

/-! Remark 3.14. If `γ ∈ Γ` is definable then it lies in the divisible hull of
`Γ(𝕊)`; this does not mean that the definable set `γ^♯ ⊆ RV` contains a
definable point unless `γ ∈ Γ(𝕊)`.

Here the base is generated by a set `V` of VF parameters, and `Γ(𝕊)` is the
value group of the field `vfParameterField V` they generate.

* `remark_3_14`: a definable `γ` has a nonzero power `γ^n` which is the value
  of a nonzero element of that field. Proof: `γ^♯` is a nonempty definable
  set, so it meets the algebraic closure (an elementary substructure,
  `elementary_meets_definable_tuple`); an algebraic RV point lifts to the
  algebraically closed field `acl(V)` (`rv_algebraicClosure_iff_lift`); and
  the value of a nonzero algebraic element has a power in the base value
  group (two maximal terms of its equation, `exists_pow_value_of_isAlgebraic`).
* `remark_3_14_converse`: conversely, a root of a definable value is
  definable (`gammaDefinableClosure_nonzero_power_root`).
* `remark_3_14_point`: over a VF-generated field base, a point of `γ^♯` in
  the base forces `γ ∈ Γ(𝕊)` itself (the RV point lifts to the field); so a
  definable `γ` outside `Γ(𝕊)` has no definable point in `γ^♯`. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Classical FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3 SpecialTransformations.Section3.GammaParameters
noncomputable section

namespace DiamondIntegral.Section3

/-- The value of a nonzero algebraic element has a nonzero power in the base
value group: two maximal terms of its equation have equal value. -/
theorem exists_pow_value_of_isAlgebraic {F K G : Type*} [Field F] [Field K] [Algebra F K]
    [LinearOrderedCommGroupWithZero G] (v : Valuation K G) (x : K) (hx₀ : x ≠ 0)
    (hx : IsAlgebraic F x) :
    ∃ n : ℕ, n ≠ 0 ∧ ∃ c : F, c ≠ 0 ∧ v x ^ n = v (algebraMap F K c) := by
  classical
  obtain ⟨P,hP,hPx⟩ := hx
  let f (i : ℕ) : K := algebraMap F K (P.coeff i) * x ^ i
  have hsum : ∑ i ∈ P.support, f i = 0 := by
    rw [Polynomial.aeval_def,Polynomial.eval₂_eq_sum,Polynomial.sum_def] at hPx
    exact hPx
  have hnonzero (i : ℕ) (hi : i ∈ P.support) : v (f i) ≠ 0 :=
    v.ne_zero_iff.mpr (mul_ne_zero
      ((map_ne_zero (algebraMap F K)).mpr (Polynomial.mem_support_iff.mp hi)) (pow_ne_zero _ hx₀))
  obtain ⟨i,hi,hmax⟩ := Finset.exists_max_image P.support (fun j => v (f j))
    (Polynomial.support_nonempty.mpr hP)
  have heq : ∃ j ∈ P.support, j ≠ i ∧ v (f j) = v (f i) := by
    by_contra! hn
    have hlt (j : ℕ) (hj : j ∈ P.support \ {i}) : v (f j) < v (f i) :=
      lt_of_le_of_ne (hmax j (Finset.mem_sdiff.mp hj).1)
        (hn j (Finset.mem_sdiff.mp hj).1
          (by simpa only [Finset.mem_singleton] using (Finset.mem_sdiff.mp hj).2))
    have h := v.map_sum_eq_of_lt hi hlt
    rw [hsum,map_zero] at h
    exact hnonzero i hi h.symm
  obtain ⟨j,hj,hne,he⟩ := heq
  have hpair : ∃ a b, a ∈ P.support ∧ b ∈ P.support ∧ a < b ∧ v (f a) = v (f b) := by
    rcases lt_or_gt_of_ne hne with h | h
    · exact ⟨j,i,hj,hi,h,he⟩
    · exact ⟨i,j,hi,hj,h,he.symm⟩
  obtain ⟨a,b,ha,hb,hab,he⟩ := hpair
  let A := v (algebraMap F K (P.coeff a))
  let B := v (algebraMap F K (P.coeff b))
  have hB : B ≠ 0 := v.ne_zero_iff.mpr
    ((map_ne_zero (algebraMap F K)).mpr (Polynomial.mem_support_iff.mp hb))
  have hpow : v x ^ a ≠ 0 := pow_ne_zero _ (v.ne_zero_iff.mpr hx₀)
  have h : A * v x ^ a = B * v x ^ b := by
    simpa only [f,map_mul,map_pow] using he
  have hb' : b = a + (b - a) := (Nat.add_sub_of_le hab.le).symm
  have h' : A * v x ^ a = (B * v x ^ (b - a)) * v x ^ a := by
    calc
      _ = B * v x ^ b := h
      _ = _ := by
        conv_lhs => rw [hb',pow_add]
        ac_rfl
  have hq : v x ^ (b - a) = v (algebraMap F K (P.coeff a / P.coeff b)) := by
    rw [map_div₀,map_div₀]
    apply (eq_div_iff hB).mpr
    rw [mul_comm]
    exact (mul_right_cancel₀ hpow h').symm
  refine ⟨b - a,Nat.sub_ne_zero_of_lt hab,P.coeff a / P.coeff b,?_,hq⟩
  exact div_ne_zero (Polynomial.mem_support_iff.mp ha) (Polynomial.mem_support_iff.mp hb)

variable {M : Type} [LRV.Structure M] [M ⊨ Axioms.ACVF]

/-- Remark 3.14: a Gamma value definable over a base generated (up to
algebraic closure) by VF parameters `V` lies in the divisible hull of the
value group of the field generated by `V`: some nonzero power of it is the
value of a nonzero element of that field. -/
theorem remark_3_14 (hc : CanonicalStructure.IsCanonical (M := M)) (h00 : M ⊨ Axioms.ACVF00)
    {Γ₀ : Type} [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation (Section2.VF M) Γ₀)
    (hv : ∀ x y : Section2.VF M, VFValued.predV x y ↔ v x ≤ v y)
    (V S : Set M) (hV : ∀ a ∈ V, iVF a) (hS : S ⊆ algebraicClosureSet V)
    (hnt : ∃ x : vfAlgebraicClosureField V, x ≠ 0 ∧ v x.val ≠ 1)
    (γ : Values.Gamma (M := M))
    (hγ : S.Definable LRV {z : Fin 1 → M | z 0 ∈ Values.gammaPullback {γ}}) :
    ∃ n : ℕ, n ≠ 0 ∧ ∃ c : Section2.VF M, c ∈ vfParameterField V ∧ c ≠ 0 ∧
      (γ ^ n).val = Section2.vfValue c := by
  -- `γ^♯` is nonempty.
  obtain ⟨y,hy⟩ := Section2.vfValue_surjective γ.val
  have hy0 : y ≠ 0 := by
    intro h
    rw [h] at hy
    exact γ.property (hy.symm.trans ((Section2.vfValue_eq_infinity_iff 0).mpr rfl))
  have hne : {z : Fin 1 → M | z 0 ∈ Values.gammaPullback {γ}}.Nonempty := by
    refine ⟨fun _ => (CanonicalRV.encodedRv y).val,(CanonicalRV.encodedRv y).property,?_,?_⟩
    · exact fun h => hy0 ((CanonicalRV.encodedRv_zero_iff y).mp h)
    · exact Subtype.ext hy
  -- It meets the algebraic closure of `V`.
  let C : LRV.ElementarySubstructure M :=
    ⟨algebraicClosureSubstructure hc V,
      canonical_algebraicClosureSubstructure_elementary v hv hc h00 V hV hnt⟩
  obtain ⟨a,ha,halg⟩ := Section2.elementary_meets_definable_tuple C _ hne (hγ.mono hS)
  obtain ⟨hRV,h0,hγa⟩ := ha
  let t : CanonicalRV.RVSort M := ⟨a 0,hRV⟩
  have htalg : AlgebraicAt V .rv t.val := algebraicAt_rv_of_mem_acl V t (halg 0)
  -- An algebraic RV point lifts to the algebraically closed field `acl(V)`.
  obtain ⟨x,hx⟩ := (rv_algebraicClosure_iff_lift h00 V hV t).mp htalg
  have hxγ : Section2.vfValue x.val = γ.val := by
    change Values.vrv (CanonicalRV.encodedRv x.val) = γ.val
    rw [hx]
    exact congrArg Subtype.val (Set.mem_singleton_iff.mp hγa)
  have hx0 : x.val ≠ 0 := by
    intro h
    rw [h] at hxγ
    exact γ.property (hxγ.symm.trans ((Section2.vfValue_eq_infinity_iff 0).mpr rfl))
  have hxalg : IsAlgebraic (vfParameterField V) x.val :=
    algebraicAt_vf_parameterField V x.val ((mem_vfAlgebraicClosureField V x.val).mp x.property)
  -- Two maximal terms.
  obtain ⟨n,hn,c,hc0,hpow⟩ := exists_pow_value_of_isAlgebraic v x.val hx0 hxalg
  refine ⟨n,hn,c.val,c.property,fun h => hc0 (Subtype.ext h),?_⟩
  have hvc : v (x.val ^ n) = v c.val := by
    rw [map_pow]
    exact hpow
  have he := (Section2.vfValue_eq_iff v hv (x.val ^ n) c.val).mpr hvc
  have hp : Section2.vfValue (x.val ^ n) = Section2.vfValue x.val ^ n :=
    map_pow Values.vfValueHom x.val n
  rw [hp,hxγ] at he
  have hγn : (γ ^ n).val = γ.val ^ n := map_pow Values.gammaValHom γ n
  rw [hγn]
  exact he

/-- Converse of Remark 3.14: a root of a definable Gamma value is definable;
so the definable Gamma values form a divisible group containing the values
of the base. -/
theorem remark_3_14_converse (B : Base (M := M)) (n : ℕ) (hn : n ≠ 0)
    (γ : Values.Gamma (M := M)) (h : GammaDefinableClosureAtBase B (γ ^ n)) :
    GammaDefinableClosureAtBase B γ :=
  gammaDefinableClosure_nonzero_power_root (n : ℤ) (by exact_mod_cast hn) γ (γ ^ n) h
    (zpow_natCast γ n)

/-- Remark 3.14, second sentence: over a VF-generated field base, an RV point
of the base in `γ^♯` forces `γ` to be the value of a nonzero field element.
Hence for a definable `γ` outside the value group of the base field, `γ^♯`
contains no point of the base. -/
theorem remark_3_14_point {S : LRV.Substructure M} (B : Section2.VFGeneratedFieldBase S)
    (γ : Values.Gamma (M := M)) (t : M) (htS : t ∈ S) (ht : t ∈ Values.gammaPullback {γ}) :
    ∃ c : B.field, c ≠ 0 ∧ γ.val = Section2.vfValue c.val := by
  obtain ⟨hRV,h0,hγt⟩ := ht
  obtain ⟨c,hc⟩ := B.rv_lift t htS hRV
  have henc : CanonicalRV.encodedRv c.val = ⟨t,hRV⟩ := Subtype.ext hc
  refine ⟨c,?_,?_⟩
  · intro hc0
    have : c.val = 0 := congrArg Subtype.val hc0
    exact h0 ((congrArg Subtype.val henc).symm.trans
      ((CanonicalRV.encodedRv_zero_iff c.val).mpr this))
  · change γ.val = Values.vrv (CanonicalRV.encodedRv c.val)
    rw [henc]
    exact (congrArg Subtype.val (Set.mem_singleton_iff.mp hγt)).symm

end DiamondIntegral.Section3
