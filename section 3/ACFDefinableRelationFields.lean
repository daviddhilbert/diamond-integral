import «section 3».ACFDefinableRationalValues
import Mathlib.RingTheory.AlgebraicIndependent.Adjoin
set_option backward.isDefEq.respectTransparency false
set_option autoImplicit false
open Classical FirstOrder FirstOrder.Language FirstOrder.Ring
noncomputable section
namespace DiamondIntegral.Section3
variable {K : Type} [Field K] [IsAlgClosed K] [CharZero K] [CompatibleRing K]
variable {n m : ℕ}

/-- Coordinatewise rationality for a partial definable graph. Only the
uniqueness at the actual input is required, not a globally total map. -/
theorem acf_definable_relation_coordinates_mem_adjoin (E : Subfield K)
    (R : Set (Fin n ⊕ Fin m → K)) (hR : (E : Set K).Definable Language.ring R)
    (x : Fin n → K) (y : Fin m → K) (hxy : Sum.elim x y ∈ R)
    (hu : ∀ z : Fin m → K, Sum.elim x z ∈ R → z = y) :
    ∀ j, y j ∈ IntermediateField.adjoin E (Set.range x) := by
  intro j
  let p : Fin n ⊕ Fin 1 → Fin n ⊕ Fin m := Sum.elim Sum.inl (fun _ => Sum.inr j)
  let S := (fun w : Fin n ⊕ Fin m → K => w ∘ p) '' R
  have hS : (E : Set K).Definable Language.ring S := hR.image_comp p
  have hpt : Sum.elim x (fun _ : Fin 1 => y j) ∈ S := by
    refine ⟨Sum.elim x y,hxy,?_⟩
    funext i
    cases i <;> rfl
  apply acf_definable_graph_value_mem_adjoin E S hS x (y j) hpt
  intro z hz
  obtain ⟨w,hw,he⟩ := hz
  have hx : ∀ i, w (Sum.inl i) = x i := fun i => congrFun he (Sum.inl i)
  have hw' : Sum.elim x (w ∘ Sum.inr) ∈ R := by
    have heq : Sum.elim x (w ∘ Sum.inr) = w := by
      funext i
      cases i with
      | inl i => exact (hx i).symm
      | inr i => rfl
    exact heq.symm ▸ hw
  have hy := congrFun (hu (w ∘ Sum.inr) hw') j
  exact (congrFun he (Sum.inr 0)).symm.trans hy

/-- A two-sided functional pure-field relation identifies the actual
fields generated by its source and target tuples. -/
theorem acf_definable_bijection_adjoin_eq (E : Subfield K)
    (R : Set (Fin n ⊕ Fin m → K)) (hR : (E : Set K).Definable Language.ring R)
    (x : Fin n → K) (y : Fin m → K) (hxy : Sum.elim x y ∈ R)
    (hu : ∀ z : Fin m → K, Sum.elim x z ∈ R → z = y)
    (hv : ∀ z : Fin n → K, Sum.elim z y ∈ R → z = x) :
    IntermediateField.adjoin E (Set.range x) = IntermediateField.adjoin E (Set.range y) := by
  have hy := acf_definable_relation_coordinates_mem_adjoin E R hR x y hxy hu
  let S : Set (Fin m ⊕ Fin n → K) := (fun w => w ∘ (Equiv.sumComm (Fin n) (Fin m))) ⁻¹' R
  have hS : (E : Set K).Definable Language.ring S := hR.preimage_comp _
  have hflip (z : Fin n → K) :
      Sum.elim y z ∈ S ↔ Sum.elim z y ∈ R := by
    change (Sum.elim y z) ∘ (Equiv.sumComm (Fin n) (Fin m)) ∈ R ↔ _
    have he : (Sum.elim y z) ∘ (Equiv.sumComm (Fin n) (Fin m)) = Sum.elim z y := by
      funext i
      cases i <;> rfl
    rw [he]
  have hx := acf_definable_relation_coordinates_mem_adjoin E S hS y x
    ((hflip x).mpr hxy) (fun z hz => hv z ((hflip z).mp hz))
  apply le_antisymm
  · exact IntermediateField.adjoin_le_iff.mpr (by rintro _ ⟨i,rfl⟩; exact hx i)
  · exact IntermediateField.adjoin_le_iff.mpr (by rintro _ ⟨i,rfl⟩; exact hy i)

end DiamondIntegral.Section3
