import «section 3».Grothendieck
import Mathlib.RingTheory.Congruence.Hom
import Mathlib.RingTheory.Congruence.Basic
import Mathlib.RingTheory.Ideal.Quotient.Defs
import Mathlib.RingTheory.Ideal.Span
import Mathlib.RingTheory.Ideal.Maps

/-! Groupification of a positive semiring congruence is quotient by the
ideal generated by the differences of its generators. No cancellation or
injectivity of the map to groupification is needed. This is the algebraic
comparison used for the two distinct relations in Notation 3.20. -/

noncomputable section
namespace DiamondIntegral.Section3
open Algebra.GrothendieckAddGroup
universe u
variable {R : Type u} [CommSemiring R]

abbrev RingCompletion (R : Type u) [CommSemiring R] := Algebra.GrothendieckAddGroup R

def relationIdeal (r : R → R → Prop) : Ideal (RingCompletion R) :=
  Ideal.span {z | ∃ a b, r a b ∧ z = of a - of b}

def quotientToIdealQuotient (r : R → R → Prop) :
    (ringConGen r).Quotient →+* RingCompletion R ⧸ relationIdeal r :=
  (ringConGen r).lift ((Ideal.Quotient.mk (relationIdeal r)).comp ofRingHom) (by
    apply RingCon.ringConGen_le.mpr
    intro a b hab
    change Ideal.Quotient.mk _ (of a) = Ideal.Quotient.mk _ (of b)
    apply sub_eq_zero.mp
    rw [← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨a, b, hab, rfl⟩))

def completionQuotientMap (r : R → R → Prop) :
    RingCompletion R →+* RingCompletion (ringConGen r).Quotient :=
  liftRingHom (ofRingHom.comp (ringConGen r).mk')

theorem relationIdeal_le_ker (r : R → R → Prop) :
    relationIdeal r ≤ RingHom.ker (completionQuotientMap r) := by
  apply Ideal.span_le.mpr
  rintro z ⟨a, b, hab, rfl⟩
  change completionQuotientMap r (of a - of b) = 0
  rw [map_sub]
  change liftRingHom (ofRingHom.comp (ringConGen r).mk') (of a) -
    liftRingHom (ofRingHom.comp (ringConGen r).mk') (of b) = 0
  rw [liftRingHom_apply_of, liftRingHom_apply_of]
  have he : (ringConGen r).mk' a = (ringConGen r).mk' b :=
    (ringConGen r).eq.mpr (RingCon.le_ringConGen a b hab)
  change of ((ringConGen r).mk' a) - of ((ringConGen r).mk' b) = 0
  rw [he, sub_self]

def idealQuotientToCompletion (r : R → R → Prop) :
    RingCompletion R ⧸ relationIdeal r →+* RingCompletion (ringConGen r).Quotient :=
  Ideal.Quotient.lift (relationIdeal r) (completionQuotientMap r)
    (fun z hz => relationIdeal_le_ker r hz)

def completedCongruenceEquiv (r : R → R → Prop) :
    RingCompletion (ringConGen r).Quotient ≃+* RingCompletion R ⧸ relationIdeal r := by
  let F := liftRingHom (quotientToIdealQuotient r)
  let B := idealQuotientToCompletion r
  have hBF : B.comp F = RingHom.id _ := by
    apply ringHom_ext
    intro q
    obtain ⟨a, rfl⟩ := (ringConGen r).mk'_surjective q
    change B (F (of ((ringConGen r).mk' a))) = of ((ringConGen r).mk' a)
    rw [show F (of ((ringConGen r).mk' a)) =
      Ideal.Quotient.mk (relationIdeal r) (of a) from liftRingHom_apply_of _ _]
    change completionQuotientMap r (of a) = _
    exact liftRingHom_apply_of _ _
  have hFB : F.comp B = RingHom.id _ := by
    apply RingHom.ext
    intro q
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
    obtain ⟨a, b, rfl⟩ := exists_eq_sub_of x
    change F (completionQuotientMap r (of a - of b)) =
      Ideal.Quotient.mk (relationIdeal r) (of a - of b)
    rw [map_sub, map_sub, map_sub]
    change F (liftRingHom (ofRingHom.comp (ringConGen r).mk') (of a)) -
      F (liftRingHom (ofRingHom.comp (ringConGen r).mk') (of b)) = _
    rw [liftRingHom_apply_of, liftRingHom_apply_of]
    change F (of ((ringConGen r).mk' a)) - F (of ((ringConGen r).mk' b)) = _
    rw [show F (of ((ringConGen r).mk' a)) =
      Ideal.Quotient.mk (relationIdeal r) (of a) from liftRingHom_apply_of _ _,
      show F (of ((ringConGen r).mk' b)) =
      Ideal.Quotient.mk (relationIdeal r) (of b) from liftRingHom_apply_of _ _]
  exact RingEquiv.ofRingHom F B hFB hBF

@[simp] theorem completedCongruenceEquiv_generator (r : R → R → Prop) (a : R) :
    completedCongruenceEquiv r (of ((ringConGen r).mk' a)) =
      Ideal.Quotient.mk (relationIdeal r) (of a) := liftRingHom_apply_of _ _

theorem relationIdeal_pair (a b : R) :
    relationIdeal (fun x y => x = a ∧ y = b) =
      Ideal.span ({of a - of b} : Set (RingCompletion R)) := by
  unfold relationIdeal
  congr 1
  ext z
  simp only [Set.mem_setOf_eq, Set.mem_singleton_iff]
  constructor
  · rintro ⟨x, y, ⟨rfl, rfl⟩, hz⟩
    exact hz
  · intro hz
    exact ⟨a, b, ⟨rfl, rfl⟩, hz⟩

theorem unmeasured_relationIdeal (p b : R) :
    relationIdeal (fun x y => x = p ∧ y = b + 1) =
      Ideal.span ({of p - of b - 1} : Set (RingCompletion R)) := by
  rw [relationIdeal_pair, map_add, ← one_def]
  congr 2
  exact (sub_sub (of p) (of b) 1).symm

theorem measured_relationIdeal (p b : R) :
    relationIdeal (fun x y => x = p ∧ y = b) =
      Ideal.span ({of p - of b} : Set (RingCompletion R)) := relationIdeal_pair p b

def groupifiedUnmeasuredRelation (p b : R) :
    RingCompletion (ringConGen (fun x y => x = p ∧ y = b + 1)).Quotient ≃+*
      RingCompletion R ⧸ Ideal.span ({of p - of b - 1} : Set (RingCompletion R)) := by
  rw [← unmeasured_relationIdeal p b]
  exact completedCongruenceEquiv (fun x y => x = p ∧ y = b + 1)

def groupifiedMeasuredRelation (p b : R) :
    RingCompletion (ringConGen (fun x y => x = p ∧ y = b)).Quotient ≃+*
      RingCompletion R ⧸ Ideal.span ({of p - of b} : Set (RingCompletion R)) := by
  rw [← measured_relationIdeal p b]
  exact completedCongruenceEquiv (fun x y => x = p ∧ y = b)

end DiamondIntegral.Section3
