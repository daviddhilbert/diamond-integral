import «section 2».Exchange
import Section3.VFDefinableClosure

/-! Lemma 2.14 (`exchange`), VF part, over an arbitrary fixed parameter base.

The checked export `lemma_2_14_vf` assumes that the VF part of the base is a
field (`VFFieldBase S`), which the printed lemma does not state. VF
algebraicity over any base is field algebraicity over the field generated by
its VF elements (`algebraicAt_vf_iff_parameterField`). Adjoining that generated
field to the base changes no VF algebraic closure and gives a field base, so
the field-base exchange transfers to every base. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

open FirstOrder FirstOrder.Language
open SpecialTransformations.Milestone0 SpecialTransformations.Milestone0.LRV
open SpecialTransformations.Section3

namespace DiamondIntegral.Section2.ExchangeGeneral
open DiamondIntegral.Section2

variable {M : Type} [LRV.Structure M] [hM : M ⊨ Axioms.ACVF]

/-- The base together with the VF field it generates. -/
def closureSet (S : Set M) : Set M := S ∪ {y | ∃ x ∈ vfParameterField S, x.val = y}

theorem vfParameterField_union_closure (S T : Set M) :
    vfParameterField (T ∪ closureSet S) = vfParameterField (T ∪ S) := by
  apply le_antisymm
  · apply Subfield.closure_le.mpr
    intro x hx
    rcases hx with hT | hS | ⟨y, hy, he⟩
    · exact Subfield.subset_closure (Or.inl hT)
    · exact Subfield.subset_closure (Or.inr hS)
    · have hxy : y = x := Subtype.ext he
      subst hxy
      exact Subfield.closure_mono (fun z hz => Or.inr hz) hy
  · exact Subfield.closure_mono (fun z hz => hz.elim Or.inl (fun h => Or.inr (Or.inl h)))

theorem vfParameterField_closure (S : Set M) : vfParameterField (closureSet S) = vfParameterField S := by
  have h := vfParameterField_union_closure S ∅
  simpa only [Set.empty_union] using h

/-- The enlarged base is a VF field base. -/
noncomputable def closureFieldBase (S : Set M) : VFFieldBase (closureSet S) where
  field := vfParameterField S
  mem_iff x := ⟨fun h => Or.inr ⟨x, h, rfl⟩,
    fun h => h.elim (fun h => Subfield.subset_closure h)
      (fun ⟨y, hy, he⟩ => (Subtype.ext he : y = x) ▸ hy)⟩

theorem algebraicAt_closure_iff (S T : Set M) (x : VF M) :
    AlgebraicAt (T ∪ closureSet S) .vf x.val ↔ AlgebraicAt (T ∪ S) .vf x.val := by
  rw [algebraicAt_vf_iff_parameterField, algebraicAt_vf_iff_parameterField,
    vfParameterField_union_closure]

/-- Lemma 2.14, VF part, over every fixed parameter base: for single VF
elements, if `a ∈ acl(S, b) ∖ acl(S)` then `b ∈ acl(S, a)`. -/
theorem lemma_2_14_vf_general (S : Set M) (a b : VF M)
    (hab : AlgebraicAt (insert b.val S) .vf a.val)
    (ha : ¬ AlgebraicAt S .vf a.val) : AlgebraicAt (insert a.val S) .vf b.val := by
  have hab' : AlgebraicAt (insert b.val (closureSet S)) .vf a.val := by
    rw [Set.insert_eq] at hab ⊢
    exact (algebraicAt_closure_iff S {b.val} a).mpr hab
  have ha' : ¬ AlgebraicAt (closureSet S) .vf a.val := by
    intro h
    apply ha
    have h' := (algebraicAt_closure_iff S ∅ a).mp (by simpa only [Set.empty_union] using h)
    simpa only [Set.empty_union] using h'
  have h := lemma_2_14_vf (closureSet S) (closureFieldBase S) a b hab' ha'
  rw [Set.insert_eq] at h ⊢
  exact (algebraicAt_closure_iff S {a.val} b).mp h

end DiamondIntegral.Section2.ExchangeGeneral
